    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="recarga gas aire acondicionado automotriz, recarga r134a domicilio santiago, aire acondicionado auto domicilio, mecánico a domicilio RM, servicio automotriz santiago, recarga aire acondicionado auto chile, detección fugas uv automotriz, globalpro automotriz" />
    <meta name="author" content="GlobalPro Automotriz" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#0b1020" />
    <link rel="canonical" href={canonical} />

    <!-- Geo Tags (Chile / Región Metropolitana) -->
    <meta name="geo.region" content="CL-RM" />
    <meta name="geo.placename" content="Santiago" />
    <meta name="geo.position" content="-33.4372;-70.6506" />
    <meta name="ICBM" content="-33.4372, -70.6506" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE_URL}/images/og/og-image.svg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Recarga de Gas Aire Acondicionado Automotriz a Domicilio en Santiago - GlobalPro" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="GlobalPro Automotriz" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}/images/og/og-image.svg`} />
    <meta name="twitter:image:alt" content="Recarga de Gas Aire Acondicionado Automotriz a Domicilio en Santiago - GlobalPro" />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Fonts: Poppins (preconnect + display=swap para mejor rendimiento) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org JSON-LD -->
    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }

    <!-- Estilos globales críticos inline (mejora FCP) -->
    <style is:global>
      :root {
        --color-primary-cyan: #00bcd4;
        --color-primary-teal: #00838f;
        --color-accent-orange: #ff6b00;
        --color-dark-navy: #0b1020;
      }
      html {
        scroll-behavior: smooth;
        /* compensar navbar fijo al hacer clic en anclas */
        scroll-padding-top: 90px;
      }
      body {
        font-family: 'Poppins', ui-sans-serif, system-ui, sans-serif;
        background-color: #ffffff;
        color: #1a1a1a;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }
      /* Reserva espacio para la barra fija inferior en mobile */
      @media (max-width: 768px) {
        body {
          padding-bottom: 72px;
        }
      }
      /* Scrollbar dark theme para secciones oscuras */
      ::-webkit-scrollbar { width: 10px; height: 10px; }
      ::-webkit-scrollbar-track { background: #0b1020; }
      ::-webkit-scrollbar-thumb { background: #00838f; border-radius: 5px; }
      ::-webkit-scrollbar-thumb:hover { background: #00bcd4; }
      /* Focus visible accesible */
      :focus-visible {
        outline: 2px solid #00bcd4;
        outline-offset: 2px;
        border-radius: 4px;
      }
      /* Animación reveal on scroll (controlada por JS IntersectionObserver) */
      [data-reveal] {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.6s ease-out, transform 0.6s ease-out;
      }
      [data-reveal].is-visible {
        opacity: 1;
        transform: translateY(0);
      }
      @media (prefers-reduced-motion: reduce) {
        [data-reveal] { opacity: 1; transform: none; transition: none; }
        .animate-pulse-slow, .animate-float, .animate-glow-pulse {
          animation: none !important;
        }
      }
    </style>
  </head>
  <body>
    <slot />

    <!-- Script global: IntersectionObserver para reveal on scroll -->
    <script>
      // Reveal on scroll (progresivo y accesible)
      const reveals = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window && reveals.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
