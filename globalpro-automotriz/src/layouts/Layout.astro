---
/**
 * Layout.astro (actualizado)
 * Soporta metadatos genéricos + Schema específico para landing de comuna.
 */
import { comunas, type Comuna } from '../data/comunas.ts';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  comuna?: Comuna;
  ogImage?: string;
}

const SITE_URL = 'https://globalproautomotriz.pages.dev';
const PHONE_DISPLAY = '+56 9 8765 4321';
const PHONE_INTL = '+56987654321';
const WHATSAPP_NUMBER = '56987654321';
const WHATSAPP_MSG = encodeURIComponent(
  'Hola GlobalPro 👋, necesito recarga de gas aire acondicionado automotriz a domicilio en Santiago. ¿Me ayudas?'
);
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${WHATSAPP_MSG}`;

const {
  title = 'Recarga de Gas Aire Acondicionado a Domicilio en Santiago | GlobalPro',
  description = 'Recarga de gas R134a a domicilio en Santiago RM desde $35.000. Llegamos en 60-90 min, técnicos certificados, 52 comunas cubiertas. Boleta/factura electrónica. Reserva por WhatsApp.',
  canonical = SITE_URL,
  comuna,
  ogImage = '/images/og/og-image.svg',
} = Astro.props;

const canonicalUrl = canonical.startsWith('http') ? canonical : `${SITE_URL}${canonical}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;

// --- Schema.org JSON-LD ---
const automotiveBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['AutomotiveBusiness', 'AutoRepair'],
  '@id': `${SITE_URL}/#business`,
  name: 'GlobalPro Automotriz / Mecánico 24/7',
  alternateName: 'Mecánico 24/7',
  description: 'Servicio automotriz a domicilio en Santiago de Chile. Recarga de gas aire acondicionado automotriz (R134a), detección de fugas UV, cambio de filtro de cabina y diagnóstico de compresor.',
  url: SITE_URL,
  telephone: PHONE_INTL,
  image: `${SITE_URL}/images/og/og-image.svg`,
  logo: `${SITE_URL}/images/logo.svg`,
  priceRange: '$$',
  currenciesAccepted: 'CLP',
  paymentAccepted: 'Efectivo, Transferencia, Transbank, Tarjeta de crédito/débito',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Av. Providencia 1208',
    addressLocality: 'Santiago',
    addressRegion: 'Región Metropolitana',
    postalCode: '7500000',
    addressCountry: 'CL',
  },
  geo: { '@type': 'GeoCoordinates', latitude: -33.4372, longitude: -70.6506 },
  areaServed: comunas.map(c => ({ '@type': 'City', name: c.nombre })),
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '08:00', closes: '22:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday','Sunday'], opens: '09:00', closes: '21:00' },
  ],
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '327', bestRating: '5', worstRating: '1' },
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Recarga de Gas Aire Acondicionado Automotriz',
  provider: { '@id': `${SITE_URL}/#business` },
  areaServed: { '@type': 'AdministrativeArea', name: 'Región Metropolitana de Santiago, Chile' },
  description: 'Recarga de gas refrigerante R134a para aire acondicionado automotriz a domicilio en Santiago y toda la Región Metropolitana.',
  offers: {
    '@type': 'Offer',
    price: '35000',
    priceCurrency: 'CLP',
    availability: 'https://schema.org/InStock',
    url: `${SITE_URL}/#precios`,
  },
};

const faqGlobal = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: '¿Cuánto demora la recarga de gas aire acondicionado a domicilio en Santiago?', acceptedAnswer: { '@type': 'Answer', text: 'Nuestro tiempo de respuesta en la Región Metropolitana es de 60 a 90 minutos. El procedimiento de recarga toma entre 30 y 45 minutos.' } },
    { '@type': 'Question', name: '¿Qué precio tiene la recarga de gas automotriz a domicilio?', acceptedAnswer: { '@type': 'Answer', text: 'El valor inicial es de $35.000 CLP e incluye diagnóstico, vacío y carga del gas refrigerante R134a.' } },
    { '@type': 'Question', name: '¿Qué comunas de Santiago cubren con el servicio a domicilio?', acceptedAnswer: { '@type': 'Answer', text: 'Cubrimos las 52 comunas de la Región Metropolitana, incluyendo Santiago Centro, Las Condes, Providencia, Vitacura, Ñuñoa, Maipú, La Florida, Puente Alto, San Bernardo, Pudahuel, Quilicura.' } },
    { '@type': 'Question', name: '¿Qué tipos de gas refrigerante utilizan?', acceptedAnswer: { '@type': 'Answer', text: 'Trabajamos principalmente con gas refrigerante R134a. Para modelos posteriores a 2017 que usan R1234yf también contamos con el equipo certificado.' } },
    { '@type': 'Question', name: '¿Ofrecen boleta o factura electrónica?', acceptedAnswer: { '@type': 'Answer', text: 'Sí. Emitimos boleta electrónica y factura electrónica. Aceptamos efectivo, transferencia bancaria y Transbank (Webpay).' } },
    { '@type': 'Question', name: '¿La recarga de gas incluye garantía?', acceptedAnswer: { '@type': 'Answer', text: 'Sí. Toda recarga incluye 90 días de garantía.' } },
    { '@type': 'Question', name: '¿Cómo sé si mi aire acondicionado automotriz necesita recarga?', acceptedAnswer: { '@type': 'Answer', text: 'Síntomas comunes: el aire no enfría como antes, tarda más en enfriar, el compresor hace ruidos o ciclos cortos de encendido/apagado.' } },
  ],
};

// Schema específico para landing de comuna
let comunaSchemas: any[] = [];
if (comuna) {
  comunaSchemas = [
    {
      '@context': 'https://schema.org',
      '@type': ['AutomotiveBusiness', 'AutoRepair'],
      '@id': `${SITE_URL}/comuna/${comuna.slug}/#business`,
      name: `GlobalPro Automotriz - Recarga de Gas A/C a Domicilio en ${comuna.nombre}`,
      description: comuna.descripcion,
      url: `${SITE_URL}/comuna/${comuna.slug}`,
      telephone: PHONE_INTL,
      image: `${SITE_URL}/images/og/og-image.svg`,
      logo: `${SITE_URL}/images/logo.svg`,
      priceRange: '$$',
      currenciesAccepted: 'CLP',
      paymentAccepted: 'Efectivo, Transferencia, Transbank',
      areaServed: { '@type': 'City', name: comuna.nombre },
      address: {
        '@type': 'PostalAddress',
        addressLocality: comuna.nombre,
        addressRegion: 'Región Metropolitana',
        addressCountry: 'CL',
      },
      geo: { '@type': 'GeoCoordinates', latitude: comuna.lat, longitude: comuna.lng },
      openingHoursSpecification: [
        { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '08:00', closes: '22:00' },
        { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday','Sunday'], opens: '09:00', closes: '21:00' },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Service',
      serviceType: 'Recarga de Gas Aire Acondicionado Automotriz a Domicilio',
      name: `Recarga de Gas A/C Automotriz a Domicilio en ${comuna.nombre}`,
      description: comuna.descripcion,
      provider: { '@id': `${SITE_URL}/comuna/${comuna.slug}/#business` },
      areaServed: { '@type': 'City', name: comuna.nombre },
      offers: {
        '@type': 'Offer',
        price: '35000',
        priceCurrency: 'CLP',
        availability: 'https://schema.org/InStock',
        url: `${SITE_URL}/comuna/${comuna.slug}#precios`,
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: comuna.faqs.map(f => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL },
        { '@type': 'ListItem', position: 2, name: 'Cobertura RM', item: `${SITE_URL}/#cobertura` },
        { '@type': 'ListItem', position: 3, name: comuna.nombre, item: `${SITE_URL}/comuna/${comuna.slug}` },
      ],
    },
  ];
}

const schemas = comuna ? comunaSchemas : [automotiveBusinessSchema, serviceSchema, faqGlobal];
---

<!doctype html>
<html lang="es-CL" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="recarga gas aire acondicionado automotriz, recarga r134a domicilio santiago, aire acondicionado auto domicilio, mecánico a domicilio RM, servicio automotriz santiago, recarga aire acondicionado auto chile, detección fugas uv automotriz, globalpro automotriz{comuna ? `, recarga gas ${comuna.nombre.toLowerCase()}, aire acondicionado ${comuna.nombre.toLowerCase()} domicilio` : ''}" />
    <meta name="author" content="GlobalPro Automotriz" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#0b1020" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Geo Tags -->
    <meta name="geo.region" content="CL-RM" />
    <meta name="geo.placename" content={comuna ? comuna.nombre : 'Santiago'} />
    <meta name="geo.position" content={comuna ? `${comuna.lat};${comuna.lng}` : '-33.4372;-70.6506'} />
    <meta name="ICBM" content={comuna ? `${comuna.lat}, ${comuna.lng}` : '-33.4372, -70.6506'} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="GlobalPro Automotriz" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Icons + PWA Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="mask-icon" href="/favicon.svg" color="#00BCD4" />

    <!-- Fonts: Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Schema.org JSON-LD -->
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Estilos globales -->
    <style is:global>
      :root {
        --color-primary-cyan: #00bcd4;
        --color-primary-teal: #00838f;
        --color-accent-orange: #ff6b00;
        --color-dark-navy: #0b1020;
      }
      html { scroll-behavior: smooth; scroll-padding-top: 90px; }
      body {
        font-family: 'Poppins', ui-sans-serif, system-ui, sans-serif;
        background-color: #ffffff;
        color: #1a1a1a;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }
      @media (max-width: 768px) { body { padding-bottom: 72px; } }
      ::-webkit-scrollbar { width: 10px; height: 10px; }
      ::-webkit-scrollbar-track { background: #0b1020; }
      ::-webkit-scrollbar-thumb { background: #00838f; border-radius: 5px; }
      ::-webkit-scrollbar-thumb:hover { background: #00bcd4; }
      :focus-visible { outline: 2px solid #00bcd4; outline-offset: 2px; border-radius: 4px; }
      [data-reveal] { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease-out, transform 0.6s ease-out; }
      [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
      @media (prefers-reduced-motion: reduce) {
        [data-reveal] { opacity: 1; transform: none; transition: none; }
        .animate-pulse-slow, .animate-float, .animate-glow-pulse, .marker-pulse { animation: none !important; }
      }
    </style>
  </head>
  <body>
    <slot />
    <script>
      const reveals = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window && reveals.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
