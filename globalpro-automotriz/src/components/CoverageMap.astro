---
/**
 * CoverageMap.astro
 * Enfoque Geo-Local con:
 *  - Buscador en tiempo real de comunas de la RM con Vanilla JS
 *  - Grid de chips interactivos con las comunas de Santiago
 */

const WHATSAPP_NUMBER = '56987654321';

// Lista completa de comunas de la Región Metropolitana (52)
const comunas = [
  'Santiago Centro', 'Cerrillos', 'Cerro Navia', 'Conchalí', 'El Bosque',
  'Estación Central', 'Huechuraba', 'Independencia', 'La Cisterna', 'La Florida',
  'La Granja', 'La Pintana', 'La Reina', 'Las Condes', 'Lo Barnechea',
  'Lo Espejo', 'Lo Prado', 'Macul', 'Maipú', 'Ñuñoa',
  'Pedro Aguirre Cerda', 'Peñalolén', 'Providencia', 'Pudahuel', 'Quilicura',
  'Quinta Normal', 'Recoleta', 'Renca', 'San Joaquín', 'San Miguel',
  'San Ramón', 'Vitacura', 'Puente Alto', 'Pirque', 'San José de Maipo',
  'Colina', 'Lampa', 'Tiltil', 'San Bernardo', 'Calera de Tango',
  'Buin', 'Paine', 'Melipilla', 'Curacaví', 'María Pinto',
  'San Pedro', 'Alhué', 'Padre Hurtado', 'Peñaflor', 'Talagante',
  'El Monte', 'Isla de Maipo',
];
---

<section id="cobertura" class="bg-dark-navy bg-hero-radial py-20 lg:py-28 relative overflow-hidden">
  <!-- Glow decorativo -->
  <div class="absolute top-20 right-20 w-80 h-80 bg-primary-cyan/15 rounded-full blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-12 lg:mb-14" data-reveal>
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary-cyan/10 text-primary-cyan text-sm font-semibold mb-4">
        <span class="h-1.5 w-1.5 rounded-full bg-primary-cyan"></span>
        Cobertura Geo-Local
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
        Cubrimos las <span class="bg-gradient-to-r from-primary-cyan to-accent-orange bg-clip-text text-transparent">52 Comunas</span> de la RM
      </h2>
      <p class="mt-5 text-lg text-white/70 leading-relaxed">
        Llegamos a cualquier punto de la Región Metropolitana en 60-90 minutos. Busca tu comuna y verifica cobertura instantáneamente.
      </p>
    </div>

    <!-- Buscador de comunas -->
    <div class="max-w-2xl mx-auto mb-10" data-reveal>
      <label for="comuna-search" class="block text-sm font-medium text-white/80 mb-2">
        Escribe el nombre de tu comuna:
      </label>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-white/40" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        <input
          type="text"
          id="comuna-search"
          placeholder="Ej: Las Condes, Maipú, Ñuñoa..."
          autocomplete="off"
          class="w-full pl-12 pr-4 py-4 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-primary-cyan focus:border-transparent text-base"
          aria-label="Buscar comuna"
        />
      </div>
      <!-- Resultado dinámico -->
      <div id="comuna-result" class="mt-4 hidden p-4 rounded-xl-card border" role="status" aria-live="polite">
        <!-- Se rellena con JS -->
      </div>
    </div>

    <!-- Grid de chips interactivos -->
    <div class="max-w-5xl mx-auto" data-reveal>
      <div id="comunas-grid" class="flex flex-wrap justify-center gap-2 lg:gap-3">
        {comunas.map((comuna) => (
          <button
            type="button"
            class="comuna-chip px-4 py-2 rounded-full bg-white/5 border border-white/10 text-white/80 text-sm font-medium hover:bg-primary-cyan/20 hover:border-primary-cyan hover:text-white transition-all cursor-pointer"
            data-comuna={comuna}
          >
            {comuna}
          </button>
        ))}
      </div>
      <p id="no-results" class="hidden text-center text-white/60 mt-6">
        No encontramos esa comuna. <a href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener noreferrer" class="text-primary-cyan underline">Consúltanos directamente →</a>
      </p>
    </div>

    <!-- CTA WhatsApp inferior -->
    <div class="mt-12 lg:mt-16 text-center" data-reveal>
      <a
        href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hola GlobalPro 👋, ¿cubren mi comuna en la RM? Te confirmo mi dirección...')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-7 py-4 rounded-full bg-whatsapp-green text-white font-bold text-base shadow-glow-orange hover:scale-105 active:scale-95 transition-transform"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.515 5.26l-.999 3.648 3.473-.607z"/>
        </svg>
        Confirmar mi cobertura por WhatsApp
      </a>
    </div>
  </div>
</section>

<script>
  // --- Buscador de comunas en tiempo real ---
  const searchInput = document.getElementById('comuna-search') as HTMLInputElement | null;
  const comunasGrid = document.getElementById('comunas-grid');
  const resultBox = document.getElementById('comuna-result');
  const noResults = document.getElementById('no-results');
  const chips = document.querySelectorAll<HTMLButtonElement>('.comuna-chip');

  const WHATSAPP_URL_BASE = 'https://wa.me/56987654321?text=';

  const showResult = (comuna: string, found: boolean) => {
    if (!resultBox) return;
    if (found) {
      const msg = encodeURIComponent(`Hola GlobalPro 👋, confirmed que cubren ${comuna}. Quiero agendar recarga de gas a domicilio.`);
      resultBox.className = 'mt-4 p-4 rounded-xl-card border bg-whatsapp-green/10 border-whatsapp-green/40 flex items-start gap-3';
      resultBox.innerHTML = `
        <svg class="w-6 h-6 text-whatsapp-green flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
        <div class="flex-1">
          <p class="text-white font-semibold text-sm">¡Sí! Cubrimos <strong>${comuna}</strong> ✓</p>
          <p class="text-white/70 text-xs mt-1">Tiempo estimado de llegada: 60-90 minutos.</p>
          <a href="${WHATSAPP_URL_BASE}${msg}" target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-1 mt-3 px-4 py-2 rounded-full bg-whatsapp-green text-white text-xs font-semibold hover:bg-whatsapp-green/90 transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24z"/>
            </svg>
            Reservar ahora
          </a>
        </div>
      `;
      resultBox.classList.remove('hidden');
    } else if (comuna.trim().length >= 2) {
      resultBox.className = 'mt-4 p-4 rounded-xl-card border bg-accent-orange/10 border-accent-orange/40';
      resultBox.innerHTML = `
        <p class="text-accent-orange-light text-sm font-semibold">No encontramos "${comuna}" en nuestra lista de la RM.</p>
        <p class="text-white/60 text-xs mt-1">Escríbenos por WhatsApp para verificar manualmente tu zona.</p>
      `;
      resultBox.classList.remove('hidden');
    } else {
      resultBox.classList.add('hidden');
    }
  };

  const filterComunas = (query: string) => {
    const q = query.trim().toLowerCase();
    let visibleCount = 0;
    chips.forEach((chip) => {
      const comuna = (chip.dataset.comuna || '').toLowerCase();
      const match = q === '' || comuna.includes(q);
      chip.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });
    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount > 0);
    }
  };

  searchInput?.addEventListener('input', (e) => {
    const value = (e.target as HTMLInputElement).value;
    filterComunas(value);
    // Verificar match exacto o parcial
    const q = value.trim().toLowerCase();
    if (q.length < 2) {
      resultBox?.classList.add('hidden');
      return;
    }
    const exactMatch = Array.from(chips).find((c) =>
      (c.dataset.comuna || '').toLowerCase().includes(q)
    );
    showResult(value.trim(), !!exactMatch);
  });

  // Click en chip: rellenar input y mostrar resultado
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const comuna = chip.dataset.comuna || '';
      if (searchInput) searchInput.value = comuna;
      filterComunas(comuna);
      showResult(comuna, true);
      // Scroll suave al resultado
      resultBox?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });
</script>
