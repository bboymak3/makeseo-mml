---
/**
 * Hero.astro
 * Sección principal con:
 *  - Fondo oscuro con overlay de gradiente y glow radial
 *  - Badge animado (pulso): "Desde $35.000 • Atención Hoy en RM"
 *  - H1 único de alto impacto
 *  - Botonera de conversión (WhatsApp + llamada)
 *  - Tarjeta flotante glassmorphism con checklist técnico
 *  - Grid 4 columnas de estadísticas
 */

const WHATSAPP_NUMBER = '56987654321';
const WHATSAPP_MSG = encodeURIComponent(
  'Hola GlobalPro 👋, quiero recarga de gas aire acondicionado a domicilio en Santiago. ¿Me confirmas cobertura y precio?'
);
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${WHATSAPP_MSG}`;
const PHONE_DISPLAY = '+56 9 8765 4321';
const PHONE_INTL = '+56987654321';

const checklist = [
  'Diagnóstico previo sin costo',
  'Gas R134a de alta pureza',
  'Vacío del sistema incluido',
  'Garantía escrita de 90 días',
  'Boleta o factura electrónica',
  'Técnicos certificados SAG',
];

const stats = [
  { value: '+10', label: 'años de experiencia', suffix: 'años' },
  { value: '52', label: 'comunas en RM', suffix: 'comunas' },
  { value: '60-90', label: 'min tiempo de respuesta', suffix: 'min' },
  { value: '100%', label: 'garantizado', suffix: '' },
];
---

<section id="inicio" class="relative overflow-hidden bg-dark-navy">
  <!-- Banner con foto real de fondo - máxima visibilidad -->
  <div class="absolute inset-0" aria-hidden="true">
    <picture>
      <source srcset="/images/gallery/recarga-gas-aire-acondicionado-automotriz-domicilio-santiago-2.webp" type="image/webp" />
      <img
        src="/images/gallery/recarga-gas-aire-acondicionado-automotriz-domicilio-santiago-2.jpg"
        alt=""
        width="900"
        height="1200"
        fetchpriority="high"
        class="w-full h-full object-cover"
      />
    </picture>
    <!-- Solo oscurecemos la parte izquierda (donde está el texto) y un degradado inferior -->
    <div class="absolute inset-0 bg-gradient-to-r from-dark-navy via-dark-navy/80 to-transparent lg:via-dark-navy/60"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-dark-navy/85 via-dark-navy/20 to-transparent"></div>
  </div>
  <!-- Glow overlays sutiles -->
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-primary-cyan/15 rounded-full blur-3xl" aria-hidden="true"></div>
  <div class="absolute -top-24 right-0 w-80 h-80 bg-accent-orange/10 rounded-full blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-28 lg:pt-32 pb-16 lg:pb-24">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Columna izquierda: copy + CTA -->
      <div class="lg:col-span-7 space-y-7" data-reveal>
        <!-- Badge animado -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent-orange/10 border border-accent-orange/30 backdrop-blur-sm">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-orange opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-accent-orange"></span>
          </span>
          <span class="text-sm font-semibold text-accent-orange-light">Desde $35.000 • Atención Hoy en RM</span>
        </div>

        <!-- H1 único -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold text-white leading-[1.05] tracking-tight">
          Recarga de Gas <span class="bg-gradient-to-r from-primary-cyan to-primary-teal bg-clip-text text-transparent">Aire Acondicionado</span> Automotriz a Domicilio en Santiago
        </h1>

        <!-- Subheadline -->
        <p class="text-lg lg:text-xl text-white/70 max-w-2xl leading-relaxed">
          Servicio móvil especializado en toda la <strong class="text-white font-semibold">Región Metropolitana</strong>. Llegamos a tu hogar u oficina en <strong class="text-primary-cyan font-semibold">60-90 minutos</strong> con equipo profesional, gas refrigerante R134a de alta pureza y técnicos certificados. Pago contra entrega con boleta o factura electrónica.
        </p>

        <!-- Botonera de conversión -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center justify-center gap-3 px-7 py-4 rounded-full bg-whatsapp-green text-white font-bold text-base shadow-glow-orange hover:scale-105 active:scale-95 transition-all duration-200"
            aria-label="Reservar recarga por WhatsApp"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.515 5.26l-.999 3.648 3.473-.607zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.521.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.521-.074-.149-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413z"/>
            </svg>
            <span>Reservar por WhatsApp</span>
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
          <a
            href={`tel:${PHONE_INTL}`}
            class="inline-flex items-center justify-center gap-3 px-7 py-4 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-white font-bold text-base hover:bg-white/15 hover:scale-105 active:scale-95 transition-all duration-200"
            aria-label={`Llamar al ${PHONE_DISPLAY}`}
          >
            <svg class="w-6 h-6 text-primary-cyan" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.62 10.79a15.46 15.46 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.24.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.21 2.2z"/>
            </svg>
            <span>Llamar Ahora</span>
          </a>
        </div>

        <!-- Microcopy trust -->
        <p class="text-sm text-white/50 flex items-center gap-2">
          <svg class="w-4 h-4 text-whatsapp-green flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.477 2 12c0 1.733.455 3.36 1.247 4.767L2 22l5.367-1.247C8.76 19.545 10.273 20 12 20c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a8 8 0 01-4.06-1.106l-.29-.172-3.18.74.74-3.18-.172-.29A8 8 0 1112 20z"/>
          </svg>
          Respuesta inmediata por WhatsApp · Lun a Dom · 4.9★ (327 reseñas)
        </p>
      </div>

      <!-- Columna derecha: glassmorphism card -->
      <div class="lg:col-span-5" data-reveal>
        <div class="relative">
          <!-- Glow detrás -->
          <div class="absolute -inset-1 bg-gradient-to-br from-primary-cyan/30 to-accent-orange/30 rounded-3xl blur-2xl animate-glow-pulse" aria-hidden="true"></div>

          <div class="relative rounded-3xl bg-dark-navy-alt/60 backdrop-blur-xl border border-white/10 p-7 shadow-2xl">
            <div class="flex items-center gap-3 mb-5">
              <div class="h-12 w-12 rounded-xl bg-gradient-to-br from-primary-cyan to-primary-teal flex items-center justify-center shadow-glow-cyan">
                <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M22 11l-9-9-9 9h2v9h5v-6h4v6h5v-9z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-white font-bold text-lg leading-tight">Servicio Garantizado</h2>
                <p class="text-white/60 text-sm">Incluye sin costo extra:</p>
              </div>
            </div>

            <ul class="space-y-3">
              {checklist.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 flex-shrink-0 h-5 w-5 rounded-full bg-whatsapp-green/20 border border-whatsapp-green/50 flex items-center justify-center">
                    <svg class="w-3 h-3 text-whatsapp-green" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                  </span>
                  <span class="text-sm text-white/85">{item}</span>
                </li>
              ))}
            </ul>

            <!-- Sello de garantía -->
            <div class="mt-6 pt-5 border-t border-white/10 flex items-center justify-between">
              <div>
                <p class="text-2xl font-extrabold text-accent-orange">$35.000<span class="text-sm font-normal text-white/50">+ CLP</span></p>
                <p class="text-xs text-white/50">precio inicial · sin traslado</p>
              </div>
              <div class="text-right">
                <div class="flex items-center gap-0.5 text-accent-orange-light justify-end">
                  {[1,2,3,4,5].map(() => (
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279L12 18.896l-7.416 3.917 1.48-8.279L0 8.306l8.332-1.151z"/>
                    </svg>
                  ))}
                </div>
                <p class="text-xs text-white/50 mt-1">4.9 / 5.0 · 327 reseñas</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Grid de estadísticas 4 columnas -->
    <div class="mt-14 lg:mt-20 grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6" data-reveal>
      {stats.map((stat) => (
        <div class="text-center lg:text-left p-5 lg:p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:border-primary-cyan/40 transition-colors">
          <div class="text-3xl lg:text-4xl font-extrabold bg-gradient-to-r from-primary-cyan to-accent-orange bg-clip-text text-transparent">
            {stat.value}{stat.suffix && <span class="text-xl lg:text-2xl ml-1">{stat.suffix}</span>}
          </div>
          <div class="mt-2 text-sm text-white/60 leading-tight">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- Wave divider inferior -->
  <div class="relative -mb-1" aria-hidden="true">
    <svg class="w-full h-12 lg:h-20 text-white" fill="currentColor" viewBox="0 0 1440 80" preserveAspectRatio="none">
      <path d="M0 80h1440V40c-240 26-480 26-720 13S240 14 0 40v40z"/>
    </svg>
  </div>
</section>
