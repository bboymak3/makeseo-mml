---
/**
 * PricingSection.astro
 * Caja de precios destacados con tipografía grande en color de acento naranja,
 * desglose de inclusiones y botón de reserva.
 */

const WHATSAPP_NUMBER = '56987654321';

const pricingPlans = [
  {
    name: 'Recarga Básica',
    price: '35.000',
    badge: 'Desde',
    description: 'Ideal para vehículos con sistema funcionando que solo necesitan reponer gas refrigerante.',
    includes: [
      'Diagnóstico previo sin costo',
      'Vacío del sistema (30 min)',
      'Carga de gas R134a por peso',
      'Prueba de rendimiento',
      'Boleta o factura electrónica',
      'Garantía escrita 90 días',
    ],
    excludes: ['Detección de fugas UV', 'Cambio de filtro de cabina'],
    cta: 'Reservar Recarga Básica',
    whatsappMsg: 'Hola GlobalPro 👋, quiero la Recarga Básica de $35.000. ¿Coordinamos visita?',
    highlighted: false,
  },
  {
    name: 'Pack Mantención',
    price: '59.000',
    badge: 'Más Popular',
    description: 'La opción más completa: recarga + detección de fugas + cambio de filtro de cabina con carbón activado.',
    includes: [
      'Todo lo de Recarga Básica',
      'Detección de fugas con tinta UV',
      'Cambio de filtro de cabina (carbón activado)',
      'Limpieza y desinfección de conductos',
      'Revisión de presiones alta/baja',
      'Informe técnico del estado del sistema',
      'Prioridad en agenda (sin espera)',
    ],
    excludes: [],
    cta: 'Reservar Pack Mantención',
    whatsappMsg: 'Hola GlobalPro 👋, quiero el Pack Mantención de $59.000. ¿Coordinamos visita?',
    highlighted: true,
  },
  {
    name: 'Diagnóstico Compresor',
    price: '30.000',
    badge: 'Especializado',
    description: 'Cuando el sistema no enfría y sospechas del compresor. Diagnóstico profundo con scanner OBD2.',
    includes: [
      'Scanner OBD2 completo',
      'Test eléctrico del embrague',
      'Verificación de presiones alta/baja',
      'Revisión sensor de presión',
      'Informe técnico detallado',
      'Cotización de reparación si aplica',
    ],
    excludes: ['Recarga de gas', 'Repuestos del compresor'],
    cta: 'Reservar Diagnóstico',
    whatsappMsg: 'Hola GlobalPro 👋, quiero el Diagnóstico de Compresor de $30.000. ¿Coordinamos?',
    highlighted: false,
  },
];
---

<section id="precios" class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-3xl mx-auto text-center mb-14 lg:mb-16" data-reveal>
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary-cyan/10 text-primary-teal text-sm font-semibold mb-4">
        <span class="h-1.5 w-1.5 rounded-full bg-primary-cyan"></span>
        Precios Transparentes
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink-dark tracking-tight">
        Precios Claros, Sin <span class="bg-gradient-to-r from-accent-orange to-accent-orange-light bg-clip-text text-transparent">Sorpresas</span>
      </h2>
      <p class="mt-5 text-lg text-text-muted leading-relaxed">
        Todos los precios están en pesos chilenos (CLP) e incluyen traslado dentro de la Región Metropolitana. El valor final se confirma antes de la visita según tu vehículo y comuna.
      </p>
    </div>

    <!-- Grid de planes -->
    <div class="grid lg:grid-cols-3 gap-6 lg:gap-8 items-start">
      {pricingPlans.map((plan) => (
        <div
          class:list={[
            'relative rounded-2xl-card p-7 lg:p-8 border-2 transition-all duration-300 hover:-translate-y-1',
            plan.highlighted
              ? 'bg-dark-navy border-accent-orange shadow-glow-orange lg:scale-105 lg:-mt-2'
              : 'bg-white border-border-light shadow-card hover:shadow-card-hover',
          ]}
          data-reveal
        >
          {/* Badge superior */}
          <div class:list={[
            'inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide mb-5',
            plan.highlighted ? 'bg-accent-orange text-white' : 'bg-primary-cyan/15 text-primary-teal'
          ]}>
            {plan.badge}
          </div>

          <h3 class:list={[
            'text-xl font-bold mb-2',
            plan.highlighted ? 'text-white' : 'text-ink-dark'
          ]}>
            {plan.name}
          </h3>
          <p class:list={[
            'text-sm leading-relaxed mb-6 min-h-[40px]',
            plan.highlighted ? 'text-white/70' : 'text-text-muted'
          ]}>
            {plan.description}
          </p>

          {/* Precio grande */}
          <div class="flex items-baseline mb-6">
            <span class:list={[
              'text-2xl font-bold mr-1',
              plan.highlighted ? 'text-white/60' : 'text-text-muted'
            ]}>$</span>
            <span class="text-5xl lg:text-6xl font-extrabold text-accent-orange leading-none">{plan.price}</span>
            <span class:list={[
              'text-sm ml-2',
              plan.highlighted ? 'text-white/60' : 'text-text-muted'
            ]}>CLP</span>
          </div>

          {/* Separador */}
          <div class:list={[
            'h-px my-6',
            plan.highlighted ? 'bg-white/10' : 'bg-border-light'
          ]}></div>

          {/* Lista de inclusiones */}
          <ul class="space-y-3 mb-7">
            {plan.includes.map((inc) => (
              <li class="flex items-start gap-3">
                <span class:list={[
                  'mt-0.5 flex-shrink-0 h-5 w-5 rounded-full flex items-center justify-center',
                  plan.highlighted ? 'bg-whatsapp-green/20 border border-whatsapp-green/50' : 'bg-whatsapp-green/15 border border-whatsapp-green/40'
                ]}>
                  <svg class="w-3 h-3 text-whatsapp-green" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                </span>
                <span class:list={[
                  'text-sm leading-snug',
                  plan.highlighted ? 'text-white/90' : 'text-ink-dark'
                ]}>{inc}</span>
              </li>
            ))}
            {plan.excludes.map((exc) => (
              <li class="flex items-start gap-3 opacity-50">
                <span class:list={[
                  'mt-0.5 flex-shrink-0 h-5 w-5 rounded-full flex items-center justify-center',
                  plan.highlighted ? 'bg-white/10 border border-white/20' : 'bg-border-light'
                ]}>
                  <svg class="w-3 h-3 text-text-muted" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                  </svg>
                </span>
                <span class:list={[
                  'text-sm leading-snug line-through',
                  plan.highlighted ? 'text-white/70' : 'text-text-muted'
                ]}>{exc}</span>
              </li>
            ))}
          </ul>

          {/* CTA */}
          <a
            href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(plan.whatsappMsg)}`}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'flex items-center justify-center gap-2 w-full px-5 py-3.5 rounded-full font-bold text-sm transition-all hover:scale-[1.02] active:scale-95',
              plan.highlighted
                ? 'bg-gradient-orange text-white shadow-glow-orange'
                : 'bg-dark-navy text-white hover:bg-accent-orange'
            ]}
            aria-label={plan.cta}
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.515 5.26l-.999 3.648 3.473-.607z"/>
            </svg>
            {plan.cta}
          </a>
        </div>
      ))}
    </div>

    <!-- Notas -->
    <div class="mt-10 lg:mt-12 grid sm:grid-cols-3 gap-4 max-w-4xl mx-auto text-center" data-reveal>
      <div class="flex flex-col items-center gap-2 p-4 rounded-xl bg-bg-alt">
        <svg class="w-6 h-6 text-primary-teal" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <p class="text-xs text-text-muted">Precio se confirma antes de la visita</p>
      </div>
      <div class="flex flex-col items-center gap-2 p-4 rounded-xl bg-bg-alt">
        <svg class="w-6 h-6 text-primary-teal" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
        </svg>
        <p class="text-xs text-text-muted">Efectivo · Transferencia · Transbank</p>
      </div>
      <div class="flex flex-col items-center gap-2 p-4 rounded-xl bg-bg-alt">
        <svg class="w-6 h-6 text-primary-teal" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
        </svg>
        <p class="text-xs text-text-muted">Garantía escrita de 90 días</p>
      </div>
    </div>
  </div>
</section>
