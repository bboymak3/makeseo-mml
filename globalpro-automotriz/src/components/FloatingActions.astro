---
/**
 * FloatingActions.astro
 * - Botón flotante de WhatsApp inferior derecho (desktop y mobile)
 * - Barra fija inferior exclusiva para móviles (Call + WhatsApp)
 */

const WHATSAPP_NUMBER = '56987654321';
const WHATSAPP_MSG = encodeURIComponent(
  'Hola GlobalPro 👋, quiero recarga de gas aire acondicionado automotriz a domicilio.'
);
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${WHATSAPP_MSG}`;
const PHONE_DISPLAY = '+56 9 8765 4321';
const PHONE_INTL = '+56987654321';
---

<!-- Botón flotante WhatsApp (desktop + mobile) -->
<a
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener noreferrer"
  id="whatsapp-float"
  class="fixed bottom-24 md:bottom-6 right-4 md:right-6 z-40 inline-flex items-center justify-center w-14 h-14 md:w-16 md:h-16 rounded-full bg-whatsapp-green text-white shadow-glow-orange hover:scale-110 active:scale-95 transition-transform"
  aria-label="Contactar por WhatsApp"
>
  <span class="absolute inset-0 rounded-full bg-whatsapp-green animate-ping opacity-20" aria-hidden="true"></span>
  <svg class="relative w-7 h-7 md:w-8 md:h-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.515 5.26l-.999 3.648 3.473-.607zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.521.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.521-.074-.149-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413z"/>
  </svg>
</a>

<!-- Tooltip flotante desktop (no mobile) -->
<div
  id="whatsapp-tooltip"
  class="hidden md:block fixed bottom-6 right-24 z-40 px-4 py-2.5 rounded-xl bg-dark-navy text-white text-sm font-medium shadow-2xl opacity-0 pointer-events-none transition-opacity duration-300"
>
  ¿Necesitas recarga de gas? Escríbenos 👋
  <span class="absolute top-1/2 -translate-y-1/2 -right-1.5 w-3 h-3 bg-dark-navy rotate-45"></span>
</div>

<!-- Barra fija inferior exclusiva mobile -->
<div class="md:hidden fixed bottom-0 left-0 right-0 z-40 grid grid-cols-2 bg-dark-navy border-t border-white/10 backdrop-blur-lg">
  <a
    href={`tel:${PHONE_INTL}`}
    class="flex flex-col items-center justify-center gap-0.5 py-3 text-white hover:bg-white/5 transition-colors"
    aria-label={`Llamar al ${PHONE_DISPLAY}`}
  >
    <svg class="w-5 h-5 text-primary-cyan" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6.62 10.79a15.46 15.46 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.24.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.21 2.2z"/>
    </svg>
    <span class="text-xs font-semibold">Llamar</span>
  </a>
  <a
    href={WHATSAPP_URL}
    target="_blank"
    rel="noopener noreferrer"
    class="flex flex-col items-center justify-center gap-0.5 py-3 bg-whatsapp-green text-white hover:bg-whatsapp-green/90 transition-colors"
    aria-label="WhatsApp"
  >
    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.515 5.26l-.999 3.648 3.473-.607z"/>
    </svg>
    <span class="text-xs font-semibold">WhatsApp</span>
  </a>
</div>

<script>
  // --- Tooltip WhatsApp desktop: aparece tras 3 segundos de inactividad ---
  const tooltip = document.getElementById('whatsapp-tooltip');
  const floatBtn = document.getElementById('whatsapp-float');

  if (tooltip && floatBtn && window.matchMedia('(min-width: 768px)').matches) {
    let timeoutId: number | undefined;

    const showTooltip = () => {
      tooltip.classList.remove('opacity-0', 'pointer-events-none');
      tooltip.classList.add('opacity-100');
    };
    const hideTooltip = () => {
      tooltip.classList.add('opacity-0', 'pointer-events-none');
      tooltip.classList.remove('opacity-100');
    };

    // Mostrar tras 3s
    timeoutId = window.setTimeout(showTooltip, 3000);

    // Ocultar al hover del botón
    floatBtn.addEventListener('mouseenter', () => {
      clearTimeout(timeoutId);
      hideTooltip();
    });

    // Ocultar tras 6s visible
    tooltip.addEventListener('transitionend', () => {
      if (tooltip.classList.contains('opacity-100')) {
        setTimeout(hideTooltip, 6000);
      }
    });
  }

  // --- Ocultar barra móvil inferior al hacer scroll hacia abajo (mejora UX) ---
  // Opcional: la dejamos siempre visible para máxima conversión
</script>
