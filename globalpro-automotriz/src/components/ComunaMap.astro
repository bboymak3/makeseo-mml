---
/**
 * ComunaMap.astro - Componente reutilizable de mapa interactivo con:
 *  - Zoom in / zoom out (botones + scroll del mouse)
 *  - Pan (arrastre del mouse o touch)
 *  - Click en marker: resalta (1 click)
 *  - Doble click en marker: abre ficha de la comuna con botón "Ir a comuna"
 *  - Click en cualquier marker resaltado y luego botón "Ir a comuna": va a la landing
 *
 * Props:
 *   variant: 'compact' (index) | 'full' (/comunas)
 */
import { comunas } from '../data/comunas.ts';

export interface Props {
  variant?: 'compact' | 'full';
  title?: string;
  subtitle?: string;
}

const {
  variant = 'full',
  title = 'Mapa Interactivo de Comunas RM',
  subtitle = 'Haz clic para resaltar · Doble clic para ver la ficha de la comuna',
} = Astro.props;

// Bounding box RM
const minLat = -34.10, maxLat = -33.05;
const minLng = -71.30, maxLng = -70.30;
const mapW = variant === 'full' ? 1000 : 800;
const mapH = variant === 'full' ? 700 : 600;

const project = (lat: number, lng: number) => {
  const x = ((lng - minLng) / (maxLng - minLng)) * mapW;
  const y = ((maxLat - lat) / (maxLat - minLat)) * mapH;
  return { x: Math.round(x), y: Math.round(y) };
};

const zonaColors: Record<string, string> = {
  Centro: '#00BCD4', Oriente: '#00838F', Norte: '#ff6b00',
  Sur: '#ff8c33', Suroriente: '#25D366', Poniente: '#5b6475',
  Surponiente: '#9c27b0', Rural: '#795548',
};

const zonas = ['Centro','Oriente','Norte','Sur','Suroriente','Poniente','Surponiente','Rural'];

// Datos serializables para JS
const comunasData = comunas.map(c => ({
  slug: c.slug,
  nombre: c.nombre,
  zona: c.zona,
  descripcion: c.descripcion,
  tiempoRespuesta: c.tiempoRespuesta,
  barrios: c.barrios || [],
  lat: c.lat,
  lng: c.lng,
  x: project(c.lat, c.lng).x,
  y: project(c.lat, c.lng).y,
  color: zonaColors[c.zona] || '#00BCD4',
  href: `/comuna/${c.slug}`,
}));
---

<section class="bg-dark-navy bg-hero-radial py-16 lg:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10" data-reveal>
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-accent-orange/10 text-accent-orange-light text-sm font-semibold mb-4">
        <span class="h-1.5 w-1.5 rounded-full bg-accent-orange"></span>
        Mapa Interactivo
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
        {title.split(' ').slice(0, -1).join(' ')} <span class="bg-gradient-to-r from-primary-cyan to-accent-orange bg-clip-text text-transparent">{title.split(' ').slice(-1)}</span>
      </h2>
      <p class="mt-4 text-white/70 max-w-2xl mx-auto">{subtitle}</p>
    </div>

    <div class:list={["grid gap-6", variant === 'full' ? 'lg:grid-cols-12' : '']} data-reveal>
      <!-- Contenedor del mapa con zoom/pan -->
      <div class={variant === 'full' ? 'lg:col-span-8' : ''}>
        <div class="relative bg-dark-navy-alt/60 backdrop-blur-sm border border-white/10 rounded-2xl-card overflow-hidden">
          <!-- Toolbar de zoom -->
          <div class="absolute top-3 right-3 z-10 flex flex-col gap-1.5">
            <button type="button" data-zoom-in class="h-10 w-10 rounded-lg bg-dark-navy/90 border border-white/20 text-white hover:bg-primary-cyan hover:border-primary-cyan flex items-center justify-center transition-colors" aria-label="Acercar mapa">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            </button>
            <button type="button" data-zoom-out class="h-10 w-10 rounded-lg bg-dark-navy/90 border border-white/20 text-white hover:bg-primary-cyan hover:border-primary-cyan flex items-center justify-center transition-colors" aria-label="Alejar mapa">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4"/></svg>
            </button>
            <button type="button" data-zoom-reset class="h-10 w-10 rounded-lg bg-dark-navy/90 border border-white/20 text-white hover:bg-accent-orange hover:border-accent-orange flex items-center justify-center transition-colors" aria-label="Restablecer vista">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            </button>
          </div>

          <!-- Indicador de zoom level -->
          <div class="absolute top-3 left-3 z-10 px-3 py-1.5 rounded-lg bg-dark-navy/90 border border-white/20 text-white text-xs font-medium">
            <span class="text-white/50">Zoom:</span> <span data-zoom-level>100%</span>
          </div>

          <!-- Buscador -->
          <div class="absolute bottom-3 left-3 right-3 z-10">
            <div class="relative max-w-md mx-auto">
              <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-white/40" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
              <input
                type="text"
                data-comuna-search
                placeholder="Buscar comuna en el mapa..."
                autocomplete="off"
                class="w-full pl-9 pr-3 py-2.5 rounded-lg bg-dark-navy/90 border border-white/15 text-white text-sm placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-primary-cyan backdrop-blur-sm"
                aria-label="Buscar comuna en el mapa"
              />
            </div>
          </div>

          <!-- Viewport (overflow hidden + cursor de pan) -->
          <div
            data-map-viewport
            class="relative w-full overflow-hidden cursor-grab active:cursor-grabbing select-none"
            style={`height: ${variant === 'full' ? '640px' : '480px'}`}
          >
            <!-- SVG que se transforma (zoom + pan) -->
            <svg
              viewBox={`0 0 ${mapW} ${mapH}`}
              preserveAspectRatio="xMidYMid meet"
              class="w-full h-full"
              data-map-svg
              role="img"
              aria-label="Mapa interactivo de comunas de la Región Metropolitana"
            >
              <defs>
                <pattern id="gridCm" width="50" height="50" patternUnits="userSpaceOnUse">
                  <path d="M 50 0 L 0 0 0 50" fill="none" stroke="rgba(0, 188, 212, 0.08)" stroke-width="1"/>
                </pattern>
                <radialGradient id="glowCm" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#00BCD4" stop-opacity="0.15"/>
                  <stop offset="100%" stop-color="#00BCD4" stop-opacity="0"/>
                </radialGradient>
              </defs>
              <rect width={mapW} height={mapH} fill="url(#gridCm)"/>
              <rect width={mapW} height={mapH} fill="url(#glowCm)"/>

              <!-- Decoración río/autopistas -->
              <path d="M 120 350 Q 350 330, 600 370 T 900 400" stroke="rgba(0, 188, 212, 0.2)" stroke-width="2" fill="none" stroke-dasharray="4 4"/>
              <path d={`M ${mapW/2} 50 L ${mapW/2} ${mapH-50}`} stroke="rgba(255, 107, 0, 0.15)" stroke-width="1.5" fill="none" stroke-dasharray="3 3"/>

              <!-- Brújula -->
              <g transform="translate(50 50)">
                <circle r="26" fill="rgba(11, 16, 32, 0.7)" stroke="rgba(0, 188, 212, 0.4)" stroke-width="1"/>
                <text x="0" y="-7" text-anchor="middle" font-size="12" font-weight="700" fill="#00BCD4">N</text>
                <path d="M 0 -17 L -5 -3 L 0 -7 L 5 -3 Z" fill="#ff6b00"/>
                <text x="0" y="17" text-anchor="middle" font-size="10" fill="rgba(255,255,255,0.5)">S</text>
              </g>

              <!-- Markers -->
              {comunasData.map((c) => (
                <g
                  data-marker-slug={c.slug}
                  transform={`translate(${c.x} ${c.y})`}
                  class="comuna-marker-g"
                  style={`--marker-color: ${c.color}; cursor: pointer;`}
                  tabindex="0"
                  role="button"
                  aria-label={`Comuna ${c.nombre}`}
                >
                  <circle r="14" fill={c.color} fill-opacity="0.15" class="marker-pulse"/>
                  <circle r="6" fill={c.color} stroke="#0b1020" stroke-width="2" class="marker-core"/>
                  <text x="0" y="-16" text-anchor="middle" font-size="11" font-weight="600" fill="rgba(255,255,255,0.7)" class="marker-label pointer-events-none">{c.nombre}</text>
                </g>
              ))}

              <!-- Leyenda -->
              <g transform={`translate(40 ${mapH - 180})`}>
                <rect x="0" y="0" width="240" height="140" rx="10" fill="rgba(11, 16, 32, 0.85)" stroke="rgba(0, 188, 212, 0.3)"/>
                <text x="14" y="20" font-size="11" font-weight="700" fill="rgba(255,255,255,0.85)">ZONAS DE COBERTURA</text>
                {zonas.map((z, i) => {
                  const col = i % 2;
                  const row = Math.floor(i / 2);
                  return (
                    <g transform={`translate(${14 + col * 110} ${38 + row * 22})`}>
                      <circle r="5" fill={zonaColors[z]}/>
                      <text x="10" y="4" font-size="10" fill="rgba(255,255,255,0.75)">{z} ({comunas.filter(c => c.zona === z).length})</text>
                    </g>
                  );
                })}
              </g>
            </svg>
          </div>

          <p class="mt-0 px-4 py-2.5 text-center text-xs text-white/40 bg-dark-navy-alt/80 border-t border-white/5">
            <strong class="text-white/60">Tip:</strong> 1 click = resaltar comuna · Doble click = abrir ficha · Arrastra para moverte · Scroll o botones +/− para zoom
          </p>
        </div>
      </div>

      {variant === 'full' && (
        <div class="lg:col-span-4 space-y-4">
          <!-- Ficha de la comuna (se rellena con JS al hacer doble click) -->
          <div id="comuna-ficha" class="bg-dark-navy-alt/60 backdrop-blur-sm border border-white/10 rounded-2xl-card p-5 transition-all" data-state="empty">
            <div class="flex items-start gap-3 mb-4">
              <span class="flex-shrink-0 h-12 w-12 rounded-xl bg-gradient-to-br from-primary-cyan to-primary-teal flex items-center justify-center" data-ficha-icon>
                <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg>
              </span>
              <div class="flex-1 min-w-0">
                <p class="text-xs text-primary-cyan font-semibold uppercase tracking-wide" data-ficha-eyebrow>Selecciona una comuna</p>
                <h3 class="text-xl font-bold text-white truncate" data-ficha-name>Doble clic en el mapa</h3>
                <p class="text-sm text-white/60" data-ficha-zona>o en la lista abajo</p>
              </div>
            </div>

            <p class="text-sm text-white/70 leading-relaxed mb-4" data-ficha-desc>
              Elige una comuna del mapa para ver sus detalles: tiempo de respuesta estimado, barrios atendidos y enlace a su landing SEO específica con FAQ propio.
            </p>

            <!-- Stats -->
            <div class="grid grid-cols-2 gap-3 mb-4" data-ficha-stats>
              <div class="bg-white/5 border border-white/10 rounded-lg p-3">
                <p class="text-[10px] text-white/50 uppercase">Tiempo respuesta</p>
                <p class="text-sm font-bold text-accent-orange-light" data-ficha-tiempo>—</p>
              </div>
              <div class="bg-white/5 border border-white/10 rounded-lg p-3">
                <p class="text-[10px] text-white/50 uppercase">Precio desde</p>
                <p class="text-sm font-bold text-accent-orange-light">$35.000 CLP</p>
              </div>
            </div>

            <!-- Barrios -->
            <div class="mb-4 hidden" data-ficha-barrios-wrap>
              <p class="text-[10px] text-white/50 uppercase mb-2">Barrios atendidos</p>
              <div class="flex flex-wrap gap-1.5" data-ficha-barrios></div>
            </div>

            <!-- Botón Ir a comuna -->
            <a
              href="#"
              data-ficha-cta
              class="flex items-center justify-center gap-2 w-full px-4 py-3 rounded-full bg-gradient-orange text-white text-sm font-semibold shadow-glow-orange hover:scale-[1.02] active:scale-95 transition-transform opacity-50 pointer-events-none"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              Ir a la landing de la comuna
            </a>
          </div>

          <!-- Lista de comunas -->
          <div class="bg-dark-navy-alt/60 backdrop-blur-sm border border-white/10 rounded-2xl-card p-4">
            <h3 class="text-white font-bold text-lg mb-3 flex items-center justify-between">
              <span>Todas las comunas</span>
              <span class="text-sm text-white/60 font-normal">{comunas.length}</span>
            </h3>
            <div class="max-h-72 overflow-y-auto pr-1 space-y-1" data-comuna-list>
              {comunasData.map((c) => (
                <button
                  type="button"
                  class="comuna-list-item flex items-center justify-between gap-2 w-full px-3 py-2.5 rounded-lg text-left text-sm text-white/80 hover:bg-primary-cyan/15 hover:text-white transition-colors"
                  data-list-slug={c.slug}
                >
                  <span class="flex items-center gap-2">
                    <span class="h-2 w-2 rounded-full" style={`background: ${c.color}`}></span>
                    {c.nombre}
                  </span>
                  <span class="text-[10px] text-white/40">{c.tiempoRespuesta}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .comuna-marker-g .marker-pulse { animation: markerPulseCm 2.5s ease-in-out infinite; transform-origin: center; }
  .comuna-marker-g:hover .marker-core { r: 9; filter: drop-shadow(0 0 8px var(--marker-color)); }
  .comuna-marker-g:hover .marker-label,
  .comuna-marker-g.is-active .marker-label { fill: #ffffff; font-size: 13px; font-weight: 700; }
  .comuna-marker-g.is-active .marker-core { r: 10; filter: drop-shadow(0 0 12px var(--marker-color)); stroke: #ffffff; stroke-width: 2.5; }
  .comuna-marker-g.is-dimmed { opacity: 0.2; }
  .comuna-marker-g:focus-visible { outline: none; }
  .comuna-marker-g:focus-visible .marker-core { r: 9; filter: drop-shadow(0 0 8px var(--marker-color)); }
  @keyframes markerPulseCm {
    0%, 100% { opacity: 0.5; r: 14; }
    50% { opacity: 0.15; r: 22; }
  }
  @media (prefers-reduced-motion: reduce) {
    .comuna-marker-g .marker-pulse { animation: none; }
  }
  #comuna-ficha[data-state="active"] [data-ficha-cta] {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script define:vars={{ comunasData, hasFicha: variant === 'full' }}>
  // ====== Estado del mapa ======
  const viewport = document.querySelector('[data-map-viewport]');
  const svg = document.querySelector('[data-map-svg]');
  const searchInput = document.querySelector('[data-comuna-search]');
  const listItems = document.querySelectorAll('[data-list-slug]');
  const markers = document.querySelectorAll('[data-marker-slug]');
  const zoomLevelEl = document.querySelector('[data-zoom-level]');

  // Estado zoom/pan
  let scale = 1;
  let tx = 0, ty = 0;
  let isDragging = false;
  let dragStartX = 0, dragStartY = 0;
  let panStartTx = 0, panStartTy = 0;
  let hasMoved = false;
  const MIN_SCALE = 1, MAX_SCALE = 4;

  const applyTransform = () => {
    svg.style.transformOrigin = '0 0';
    svg.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
    if (zoomLevelEl) zoomLevelEl.textContent = `${Math.round(scale * 100)}%`;
  };

  const setZoom = (newScale, centerX, centerY) => {
    newScale = Math.max(MIN_SCALE, Math.min(MAX_SCALE, newScale));
    if (centerX !== undefined && centerY !== undefined) {
      // Mantener el punto bajo el cursor estable
      const rect = viewport.getBoundingClientRect();
      const px = centerX - rect.left;
      const py = centerY - rect.top;
      const scaleRatio = newScale / scale;
      tx = px - (px - tx) * scaleRatio;
      ty = py - (py - ty) * scaleRatio;
    }
    scale = newScale;
    applyTransform();
  };

  // Zoom con botones
  document.querySelector('[data-zoom-in]')?.addEventListener('click', () => {
    const rect = viewport.getBoundingClientRect();
    setZoom(scale * 1.3, rect.left + rect.width / 2, rect.top + rect.height / 2);
  });
  document.querySelector('[data-zoom-out]')?.addEventListener('click', () => {
    const rect = viewport.getBoundingClientRect();
    setZoom(scale / 1.3, rect.left + rect.width / 2, rect.top + rect.height / 2);
  });
  document.querySelector('[data-zoom-reset]')?.addEventListener('click', () => {
    scale = 1; tx = 0; ty = 0;
    applyTransform();
  });

  // Zoom con rueda del mouse
  viewport?.addEventListener('wheel', (e) => {
    e.preventDefault();
    const delta = e.deltaY > 0 ? 0.85 : 1.18;
    setZoom(scale * delta, e.clientX, e.clientY);
  }, { passive: false });

  // Pan con arrastre del mouse
  viewport?.addEventListener('pointerdown', (e) => {
    // No iniciar pan si el click fue sobre un marker (dejar que el marker maneje su click)
    const target = e.target.closest('[data-marker-slug]');
    if (target) return;
    isDragging = true;
    hasMoved = false;
    dragStartX = e.clientX;
    dragStartY = e.clientY;
    panStartTx = tx;
    panStartTy = ty;
    viewport.setPointerCapture(e.pointerId);
  });

  viewport?.addEventListener('pointermove', (e) => {
    if (!isDragging) return;
    const dx = e.clientX - dragStartX;
    const dy = e.clientY - dragStartY;
    if (Math.abs(dx) > 4 || Math.abs(dy) > 4) hasMoved = true;
    tx = panStartTx + dx;
    ty = panStartTy + dy;
    applyTransform();
  });

  viewport?.addEventListener('pointerup', (e) => {
    if (isDragging) {
      viewport.releasePointerCapture(e.pointerId);
      isDragging = false;
    }
  });

  // ====== Click en markers: 1 click = resaltar, 2 clicks = abrir ficha ======
  let activeSlug = null;
  let lastClickSlug = null;
  let lastClickTime = 0;
  const DOUBLE_CLICK_THRESHOLD = 350; // ms

  const fichaName = document.querySelector('[data-ficha-name]');
  const fichaEyebrow = document.querySelector('[data-ficha-eyebrow]');
  const fichaZona = document.querySelector('[data-ficha-zona]');
  const fichaDesc = document.querySelector('[data-ficha-desc]');
  const fichaTiempo = document.querySelector('[data-ficha-tiempo]');
  const fichaBarriosWrap = document.querySelector('[data-ficha-barrios-wrap]');
  const fichaBarrios = document.querySelector('[data-ficha-barrios]');
  const fichaCta = document.querySelector('[data-ficha-cta]');
  const ficha = document.getElementById('comuna-ficha');

  const highlightMarker = (slug) => {
    // Toggle: si clickeaste el mismo marker activo, lo desactiva
    if (activeSlug === slug) {
      activeSlug = null;
      markers.forEach(m => m.classList.remove('is-active'));
      listItems.forEach(i => i.classList.remove('bg-primary-cyan/15', 'text-white'));
      return;
    }
    activeSlug = slug;
    markers.forEach(m => m.classList.toggle('is-active', m.dataset.markerSlug === slug));
    listItems.forEach(i => i.classList.toggle('bg-primary-cyan/15', i.dataset.listSlug === slug));
    listItems.forEach(i => i.classList.toggle('text-white', i.dataset.listSlug === slug));
  };

  const openFicha = (slug) => {
    const comuna = comunasData.find(c => c.slug === slug);
    if (!comuna) return;
    if (!hasFicha) {
      // En modo compact sin ficha: doble click = ir directo a la landing
      window.location.href = comuna.href;
      return;
    }
    if (fichaName) fichaName.textContent = comuna.nombre;
    if (fichaEyebrow) fichaEyebrow.textContent = `Zona ${comuna.zona}`;
    if (fichaZona) fichaZona.textContent = `Región Metropolitana · ${comuna.tiempoRespuesta}`;
    if (fichaDesc) fichaDesc.textContent = comuna.descripcion;
    if (fichaTiempo) fichaTiempo.textContent = comuna.tiempoRespuesta;
    if (fichaBarrios && comuna.barrios.length > 0) {
      fichaBarrios.innerHTML = comuna.barrios.map(b => `<span class="px-2 py-0.5 rounded-full bg-white/5 border border-white/10 text-white/70 text-[10px]">${b}</span>`).join('');
      if (fichaBarriosWrap) fichaBarriosWrap.classList.remove('hidden');
    } else if (fichaBarriosWrap) {
      fichaBarriosWrap.classList.add('hidden');
    }
    if (fichaCta) {
      fichaCta.setAttribute('href', comuna.href);
      fichaCta.removeAttribute('aria-disabled');
    }
    if (ficha) ficha.setAttribute('data-state', 'active');
    if (ficha) ficha.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  };

  const handleMarkerActivate = (slug) => {
    const now = Date.now();
    if (slug === lastClickSlug && (now - lastClickTime) < DOUBLE_CLICK_THRESHOLD) {
      // Doble click: abrir ficha
      openFicha(slug);
      lastClickSlug = null;
      lastClickTime = 0;
    } else {
      // Click simple: resaltar
      highlightMarker(slug);
      lastClickSlug = slug;
      lastClickTime = now;
    }
  };

  markers.forEach(marker => {
    marker.addEventListener('click', (e) => {
      e.stopPropagation();
      if (hasMoved) return; // si arrastró, no es un click real
      handleMarkerActivate(marker.dataset.markerSlug);
    });
    marker.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        handleMarkerActivate(marker.dataset.markerSlug);
      } else if (e.key === ' ') {
        e.preventDefault();
        openFicha(marker.dataset.markerSlug);
      }
    });
  });

  // Click en item de la lista: mismo comportamiento (1 click resalta, 2 abre ficha)
  listItems.forEach(item => {
    item.addEventListener('click', () => {
      handleMarkerActivate(item.dataset.listSlug);
    });
  });

  // ====== Buscador ======
  searchInput?.addEventListener('input', (e) => {
    const q = e.target.value.toLowerCase().trim();
    let visibleCount = 0;
    listItems.forEach(item => {
      const slug = item.dataset.listSlug || '';
      const text = item.textContent || '';
      const match = q === '' || text.toLowerCase().includes(q) || slug.includes(q);
      item.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });
    markers.forEach(m => {
      const slug = m.dataset.markerSlug || '';
      const comuna = comunasData.find(c => c.slug === slug);
      const nombre = (comuna?.nombre || '').toLowerCase();
      const match = q === '' || nombre.includes(q) || slug.includes(q);
      m.classList.toggle('is-dimmed', !match && q !== '');
    });
  });

  applyTransform();
</script>
