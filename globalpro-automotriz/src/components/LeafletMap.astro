---
/**
 * LeafletMap.astro - Mapa interactivo performante usando Leaflet + tiles CartoDB.
 * - Solo ~40KB JS (CDN)
 * - Zoom y pan nativos del navegador (sin lag)
 * - Tiles oscuros que combinan con el tema dark-navy
 * - Click en marker = abre popup con info + botón "Ir a comuna"
 *
 * Variantes:
 *   - compact: vista inicial más cercana, altura 480px (para index)
 *   - full: vista inicial de toda la RM, altura 640px + panel lateral (para /comunas)
 */
import { comunas } from '../data/comunas.ts';

export interface Props {
  variant?: 'compact' | 'full';
  title?: string;
  subtitle?: string;
}

const {
  variant = 'full',
  title = 'Mapa Interactivo RM',
  subtitle = 'Click en cualquier comuna para ver detalles · Arrastra para moverte · Scroll o botones +/− para zoom',
} = Astro.props;

const zonaColors: Record<string, string> = {
  Centro: '#00BCD4', Oriente: '#00838F', Norte: '#ff6b00',
  Sur: '#ff8c33', Suroriente: '#25D366', Poniente: '#5b6475',
  Surponiente: '#9c27b0', Rural: '#795548',
};

// Datos serializables para JS (solo lo necesario)
const markersData = comunas.map(c => ({
  slug: c.slug,
  nombre: c.nombre,
  zona: c.zona,
  descripcion: c.descripcion,
  tiempoRespuesta: c.tiempoRespuesta,
  barrios: (c.barrios || []).slice(0, 6),
  totalBarrios: (c.barrios || []).length,
  lat: c.lat,
  lng: c.lng,
  color: zonaColors[c.zona] || '#00BCD4',
  href: `/comuna/${c.slug}`,
}));

const zonas = ['Centro','Oriente','Norte','Sur','Suroriente','Poniente','Surponiente','Rural'];
---

<section class="bg-dark-navy bg-hero-radial py-16 lg:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10" data-reveal>
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-accent-orange/10 text-accent-orange-light text-sm font-semibold mb-4">
        <span class="h-1.5 w-1.5 rounded-full bg-accent-orange"></span>
        Mapa Interactivo
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
        {title.split(' ').slice(0, -1).join(' ')} <span class="bg-gradient-to-r from-primary-cyan to-accent-orange bg-clip-text text-transparent">{title.split(' ').slice(-1)}</span>
      </h2>
      <p class="mt-4 text-white/70 max-w-2xl mx-auto">{subtitle}</p>
    </div>

    <div class:list={["grid gap-6", variant === 'full' ? 'lg:grid-cols-12' : '']} data-reveal>
      <!-- Contenedor del mapa Leaflet -->
      <div class={variant === 'full' ? 'lg:col-span-8' : ''}>
        <div class="relative bg-dark-navy-alt/60 backdrop-blur-sm border border-white/10 rounded-2xl-card overflow-hidden">
          <div
            id="leaflet-map"
            class="w-full"
            style={`height: ${variant === 'full' ? '640px' : '480px'}; background: #0b1020; z-index: 1;`}
            role="application"
            aria-label="Mapa interactivo de comunas de la Región Metropolitana"
          ></div>

          <!-- Leyenda flotante (sobre el mapa) -->
          <div class="absolute bottom-3 left-3 z-[1000] bg-dark-navy/90 backdrop-blur-sm border border-white/10 rounded-xl-card p-3 max-w-[260px]">
            <p class="text-white text-xs font-bold mb-2 uppercase tracking-wide">Zonas de cobertura</p>
            <div class="grid grid-cols-2 gap-x-3 gap-y-1">
              {zonas.map(z => (
                <div class="flex items-center gap-1.5">
                  <span class="h-2 w-2 rounded-full flex-shrink-0" style={`background: ${zonaColors[z]}`}></span>
                  <span class="text-white/70 text-[10px]">{z}</span>
                </div>
              ))}
            </div>
          </div>

          <p class="px-4 py-2.5 text-center text-xs text-white/40 bg-dark-navy-alt/80 border-t border-white/5">
            <strong class="text-white/60">Tip:</strong> Click en cualquier marker para ver la ficha · Botones +/− para zoom · Arrastra para moverte
          </p>
        </div>
      </div>

      {variant === 'full' && (
        <div class="lg:col-span-4 space-y-4">
          <!-- Buscador + lista -->
          <div class="bg-dark-navy-alt/60 backdrop-blur-sm border border-white/10 rounded-2xl-card p-4">
            <h3 class="text-white font-bold text-lg mb-3 flex items-center justify-between">
              <span>Todas las comunas</span>
              <span class="text-sm text-white/60 font-normal">{comunas.length}</span>
            </h3>
            <div class="relative mb-3">
              <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-white/40" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
              <input
                type="text"
                id="leaflet-search"
                placeholder="Buscar comuna..."
                autocomplete="off"
                class="w-full pl-9 pr-3 py-2.5 rounded-lg bg-white/10 border border-white/15 text-white text-sm placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-primary-cyan"
                aria-label="Buscar comuna"
              />
            </div>
            <div id="leaflet-list" class="max-h-[560px] overflow-y-auto pr-1 space-y-1">
              {markersData.map((c) => (
                <button
                  type="button"
                  class="leaflet-list-item flex items-center justify-between gap-2 w-full px-3 py-2.5 rounded-lg text-left text-sm text-white/80 hover:bg-primary-cyan/15 hover:text-white transition-colors"
                  data-list-slug={c.slug}
                >
                  <span class="flex items-center gap-2">
                    <span class="h-2 w-2 rounded-full flex-shrink-0" style={`background: ${c.color}`}></span>
                    <span>{c.nombre}</span>
                  </span>
                  <span class="text-[10px] text-white/40 flex-shrink-0">{c.tiempoRespuesta}</span>
                </button>
              ))}
            </div>
            <p id="leaflet-no-results" class="hidden text-center py-4 text-white/50 text-sm">Ninguna comuna coincide.</p>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<!-- Leaflet CSS (CDN, ~14KB gzipped) -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="" />

<!-- Leaflet JS (CDN, ~40KB gzipped) -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""></script>

<style is:global>
  /* Ajustes de Leaflet para tema oscuro */
  .leaflet-container {
    background: #0b1020 !important;
    font-family: 'Poppins', sans-serif !important;
  }
  /* Invertir y teñir tiles OSM para combinar con dark-navy */
  .osm-dark-tiles {
    filter: invert(1) hue-rotate(180deg) brightness(0.85) contrast(0.9) saturate(0.7);
  }
  /* En pantallas con prefers-reduced-motion no afecta, pero aseguramos tile rendering suave */
  .leaflet-tile {
    will-change: auto;
  }
  .leaflet-control-zoom a {
    background: rgba(11, 16, 32, 0.95) !important;
    color: #ffffff !important;
    border-color: rgba(255, 255, 255, 0.15) !important;
    transition: background-color 0.15s;
  }
  .leaflet-control-zoom a:hover {
    background: #00BCD4 !important;
    color: #0b1020 !important;
  }
  .leaflet-control-attribution {
    background: rgba(11, 16, 32, 0.85) !important;
    color: rgba(255, 255, 255, 0.5) !important;
    font-size: 9px !important;
  }
  .leaflet-control-attribution a {
    color: #00BCD4 !important;
  }
  /* Popup temático */
  .leaflet-popup-content-wrapper {
    background: #121a33 !important;
    color: #ffffff !important;
    border-radius: 14px !important;
    border: 1px solid rgba(0, 188, 212, 0.3) !important;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5) !important;
    padding: 0 !important;
  }
  .leaflet-popup-content {
    margin: 0 !important;
    width: 260px !important;
  }
  .leaflet-popup-tip {
    background: #121a33 !important;
    border: 1px solid rgba(0, 188, 212, 0.3) !important;
  }
  .leaflet-popup-close-button {
    color: #ffffff !important;
    font-size: 22px !important;
    padding: 8px 10px !important;
    opacity: 0.7;
  }
  .leaflet-popup-close-button:hover { opacity: 1; }
  /* Marker custom (divIcon) */
  .comuna-marker-leaflet {
    background: transparent !important;
    border: none !important;
  }
  .comuna-marker-leaflet .dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2.5px solid #0b1020;
    box-shadow: 0 0 0 4px rgba(255,255,255,0.08), 0 2px 6px rgba(0,0,0,0.4);
    transition: transform 0.15s ease-out;
    cursor: pointer;
  }
  .comuna-marker-leaflet .dot:hover {
    transform: scale(1.3);
  }
  .comuna-marker-leaflet.is-active .dot {
    transform: scale(1.5);
    box-shadow: 0 0 0 6px rgba(255, 107, 0, 0.35), 0 0 20px currentColor;
  }
</style>

<script define:vars={{ markersData, variant }}>
  // Esperar a que Leaflet cargue (CDN script)
  const initMap = () => {
    if (typeof window.L === 'undefined') {
      setTimeout(initMap, 50);
      return;
    }
    const L = window.L;

    // Centro de la RM + zoom inicial según variante
    const map = L.map('leaflet-map', {
      center: [-33.45, -70.65],
      zoom: variant === 'full' ? 10 : 11,
      minZoom: 9,
      maxZoom: 16,
      zoomControl: true,
      scrollWheelZoom: true,
      preferCanvas: false,
    });

    // Tiles de OpenStreetMap estándar (gratis, sin API key, sin límites duros)
    // Se les aplica un filtro CSS para adaptarlos al tema oscuro
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      subdomains: 'abc',
      maxZoom: 19,
      className: 'osm-dark-tiles',
    }).addTo(map);

    // Crear icono custom para cada comuna
    const makeIcon = (color) => L.divIcon({
      className: 'comuna-marker-leaflet',
      html: `<div class="dot" style="background:${color}; color:${color};"></div>`,
      iconSize: [16, 16],
      iconAnchor: [8, 8],
      popupAnchor: [0, -10],
    });

    // Crear markers con popup
    const markersMap = {};
    markersData.forEach(c => {
      const marker = L.marker([c.lat, c.lng], { icon: makeIcon(c.color) }).addTo(map);
      const barriosHtml = c.barrios.length > 0
        ? `<div style="margin-top:8px;">
            <p style="font-size:10px;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">Barrios atendidos</p>
            <div style="display:flex;flex-wrap:wrap;gap:4px;">
              ${c.barrios.map(b => `<span style="display:inline-block;padding:2px 6px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:99px;font-size:10px;color:rgba(255,255,255,0.75);">${b}</span>`).join('')}
              ${c.totalBarrios > 6 ? `<span style="display:inline-block;padding:2px 6px;font-size:10px;color:rgba(255,255,255,0.5);">+${c.totalBarrios - 6} más</span>` : ''}
            </div>
          </div>`
        : '';

      const popupHtml = `
        <div style="padding:14px 16px;">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
            <span style="width:10px;height:10px;border-radius:50%;background:${c.color};flex-shrink:0;box-shadow:0 0 8px ${c.color};"></span>
            <span style="font-size:10px;color:#00BCD4;text-transform:uppercase;letter-spacing:0.8px;font-weight:600;">Zona ${c.zona}</span>
          </div>
          <h3 style="font-size:18px;font-weight:800;color:#ffffff;margin:0 0 6px 0;line-height:1.2;">${c.nombre}</h3>
          <p style="font-size:11px;color:rgba(255,255,255,0.55);margin:0 0 10px 0;">Región Metropolitana · ${c.tiempoRespuesta}</p>
          <p style="font-size:12px;color:rgba(255,255,255,0.75);line-height:1.5;margin:0 0 10px 0;">${c.descripcion.slice(0, 140)}${c.descripcion.length > 140 ? '...' : ''}</p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:12px;">
            <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:6px 8px;">
              <p style="font-size:9px;color:rgba(255,255,255,0.5);text-transform:uppercase;margin:0 0 2px;">Tiempo</p>
              <p style="font-size:13px;font-weight:700;color:#ff8c33;margin:0;">${c.tiempoRespuesta}</p>
            </div>
            <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:6px 8px;">
              <p style="font-size:9px;color:rgba(255,255,255,0.5);text-transform:uppercase;margin:0 0 2px;">Desde</p>
              <p style="font-size:13px;font-weight:700;color:#ff8c33;margin:0;">$35.000</p>
            </div>
          </div>
          ${barriosHtml}
          <a href="${c.href}" style="display:flex;align-items:center;justify-content:center;gap:6px;width:100%;padding:10px 14px;margin-top:12px;background:linear-gradient(135deg,#ff6b00,#ff8c33);color:#ffffff;text-decoration:none;border-radius:99px;font-size:13px;font-weight:700;box-shadow:0 6px 18px rgba(255,107,0,0.35);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            Ir a la landing de ${c.nombre}
          </a>
        </div>
      `;
      marker.bindPopup(popupHtml, { maxWidth: 300, minWidth: 260, closeButton: true });
      marker.on('click', () => {
        // Quitar estado activo de otros markers
        Object.values(markersMap).forEach(m => m.getElement()?.classList.remove('is-active'));
        marker.getElement()?.classList.add('is-active');
      });
      markersMap[c.slug] = marker;
    });

    // ====== Buscador + lista (solo variante full) ======
    const searchInput = document.getElementById('leaflet-search');
    const listItems = document.querySelectorAll('[data-list-slug]');
    const noResults = document.getElementById('leaflet-no-results');

    const filterComunas = (q) => {
      const query = q.toLowerCase().trim();
      let visibleCount = 0;
      listItems.forEach(item => {
        const slug = item.dataset.listSlug || '';
        const text = item.textContent || '';
        const match = query === '' || text.toLowerCase().includes(query) || slug.includes(query);
        item.style.display = match ? '' : 'none';
        if (match) visibleCount++;
      });
      if (noResults) noResults.classList.toggle('hidden', visibleCount > 0);
      // Mostrar/ocultar markers según búsqueda
      markersData.forEach(c => {
        const nombre = c.nombre.toLowerCase();
        const match = query === '' || nombre.includes(query) || c.slug.includes(query);
        if (match) {
          markersMap[c.slug]?.addTo(map);
        } else {
          markersMap[c.slug]?.removeFrom(map);
        }
      });
    };

    searchInput?.addEventListener('input', (e) => filterComunas(e.target.value));

    // Click en item de la lista: centrar mapa + abrir popup
    listItems.forEach(item => {
      item.addEventListener('click', () => {
        const slug = item.dataset.listSlug;
        const comuna = markersData.find(c => c.slug === slug);
        if (!comuna || !markersMap[slug]) return;
        map.flyTo([comuna.lat, comuna.lng], 13, { duration: 0.8 });
        setTimeout(() => markersMap[slug].openPopup(), 850);
      });
    });
  };

  // Inicializar cuando DOM esté listo y Leaflet cargado
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMap);
  } else {
    initMap();
  }
</script>
