---
/**
 * ProcessSteps.astro
 * Flujo de 4 pasos numerados con badges flotantes naranjas (01 al 04).
 */

const steps = [
  {
    number: '01',
    title: 'Contáctanos por WhatsApp',
    description: 'Escríbenos por WhatsApp o llámanos con tu ubicación, marca y modelo del vehículo. Confirmamos cobertura de tu comuna en la RM y precio final.',
    icon: 'chat',
  },
  {
    number: '02',
    title: 'Coordinamos tu visita',
    description: 'Agendamos una hora que se acomode a tu rutina. Llegamos en 60-90 minutos con todo el equipo profesional: manómetros, bomba de vacío y balanza de carga.',
    icon: 'calendar',
  },
  {
    number: '03',
    title: 'Realizamos el servicio',
    description: 'Diagnosticamos, vaciamos el sistema y cargamos el gas refrigerante por peso. Verificamos presiones alta/baja y rendimiento de enfriamiento en cabina.',
    icon: 'wrench',
  },
  {
    number: '04',
    title: 'Pagas y disfrutas',
    description: 'Recibes boleta o factura electrónica al instante. Pagas con efectivo, transferencia o Transbank. Garantía escrita de 90 días sobre el servicio prestado.',
    icon: 'check',
  },
];

const iconMap: Record<string, string> = {
  chat: 'M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z',
  calendar: 'M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V6a2 2 0 00-2-2zm0 16H5V10h14v10z',
  wrench: 'M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z',
  check: 'M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z',
};

const WHATSAPP_NUMBER = '56987654321';
const WHATSAPP_MSG = encodeURIComponent('Hola GlobalPro 👋, quiero empezar el proceso de recarga de gas a domicilio.');
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${WHATSAPP_MSG}`;
---

<section id="proceso" class="bg-bg-alt py-20 lg:py-28 relative overflow-hidden">
  <!-- Decoración de fondo -->
  <div class="absolute top-0 right-0 w-72 h-72 bg-primary-cyan/5 rounded-full blur-3xl" aria-hidden="true"></div>
  <div class="absolute bottom-0 left-0 w-72 h-72 bg-accent-orange/5 rounded-full blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-14 lg:mb-20" data-reveal>
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-accent-orange/10 text-accent-orange text-sm font-semibold mb-4">
        <span class="h-1.5 w-1.5 rounded-full bg-accent-orange"></span>
        Cómo Trabajamos
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink-dark tracking-tight">
        Proceso Simple en <span class="bg-gradient-to-r from-accent-orange to-accent-orange-light bg-clip-text text-transparent">4 Pasos</span>
      </h2>
      <p class="mt-5 text-lg text-text-muted leading-relaxed">
        Desde tu primer mensaje hasta el pago final, todo está diseñado para que no tengas que moverte de tu casa u oficina. Servicio a domicilio real, sin sorpresas ni costos ocultos.
      </p>
    </div>

    <!-- Grid de pasos -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 relative">
      <!-- Línea conectora horizontal (desktop) -->
      <div class="hidden lg:block absolute top-12 left-[12.5%] right-[12.5%] h-0.5 bg-gradient-to-r from-primary-cyan via-accent-orange to-accent-orange-light opacity-30" aria-hidden="true"></div>

      {steps.map((step) => (
        <div class="relative bg-white rounded-xl-card border border-border-light p-6 shadow-card hover:shadow-card-hover transition-shadow" data-reveal>
          <!-- Badge flotante naranja numerado -->
          <div class="absolute -top-4 -left-4 h-12 w-12 rounded-xl bg-gradient-to-br from-accent-orange to-accent-orange-light text-white font-extrabold text-lg flex items-center justify-center shadow-glow-orange border-2 border-white">
            {step.number}
          </div>

          <!-- Icono principal -->
          <div class="mt-4 mb-4 inline-flex h-12 w-12 rounded-xl bg-gradient-to-br from-primary-cyan/15 to-primary-teal/15 border border-primary-cyan/20 items-center justify-center">
            <svg class="w-6 h-6 text-primary-teal" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={iconMap[step.icon]}/>
            </svg>
          </div>

          <h3 class="text-lg font-bold text-ink-dark leading-tight">{step.title}</h3>
          <p class="mt-2 text-sm text-text-muted leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>

    <!-- CTA inferior -->
    <div class="mt-12 lg:mt-16 text-center" data-reveal>
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-7 py-4 rounded-full bg-gradient-orange text-white font-bold text-base shadow-glow-orange hover:scale-105 active:scale-95 transition-transform"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.515 5.26l-.999 3.648 3.473-.607z"/>
        </svg>
        Comenzar Ahora por WhatsApp
      </a>
      <p class="mt-3 text-sm text-text-muted">Tiempo de respuesta promedio: 4 minutos</p>
    </div>
  </div>
</section>
