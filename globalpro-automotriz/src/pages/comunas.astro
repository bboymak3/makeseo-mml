---
/**
 * src/pages/comunas.astro
 * Landing hub con todas las comunas + mapa interactivo ampliado (zoom/pan + ficha).
 */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import LeafletMap from '../components/LeafletMap.astro';
import FloatingActions from '../components/FloatingActions.astro';
import Footer from '../components/Footer.astro';
import { comunas } from '../data/comunas.ts';

const WHATSAPP_NUMBER = '56987654321';

const title = 'Comunas Atendidas en la Región Metropolitana | GlobalPro Automotriz';
const description = 'Listado completo de las 52 comunas de la Región Metropolitana donde GlobalPro ofrece recarga de gas aire acondicionado automotriz a domicilio. Mapa interactivo con zoom, búsqueda en tiempo real y enlace a landing SEO dedicada por comuna.';

const zonas = ['Centro','Oriente','Norte','Sur','Suroriente','Poniente','Surponiente','Rural'];
const comunasPorZona = zonas.map(z => ({ zona: z, items: comunas.filter(c => c.zona === z) }));

const zonaColors: Record<string, string> = {
  Centro: '#00BCD4', Oriente: '#00838F', Norte: '#ff6b00',
  Sur: '#ff8c33', Suroriente: '#25D366', Poniente: '#5b6475',
  Surponiente: '#9c27b0', Rural: '#795548',
};
---

<Layout title={title} description={description} canonical="/comunas">
  <Navbar />

  <main class="pt-20">
    <!-- Hero -->
    <section class="relative overflow-hidden bg-dark-navy bg-hero-radial py-16 lg:py-24">
      <div class="absolute -top-32 -left-32 w-96 h-96 bg-primary-cyan/20 rounded-full blur-3xl animate-pulse-slow" aria-hidden="true"></div>
      <div class="absolute -top-24 right-0 w-80 h-80 bg-accent-orange/15 rounded-full blur-3xl" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary-cyan/10 text-primary-cyan text-sm font-semibold mb-4">
          <span class="h-1.5 w-1.5 rounded-full bg-primary-cyan"></span>
          Cobertura Regional
        </span>
        <h1 class="text-4xl lg:text-5xl xl:text-6xl font-extrabold text-white tracking-tight">
          Las <span class="bg-gradient-to-r from-primary-cyan to-accent-orange bg-clip-text text-transparent">52 Comunas</span> de la Región Metropolitana
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-white/70 max-w-3xl mx-auto leading-relaxed">
          Llegamos a toda la Región Metropolitana de Santiago en <strong class="text-primary-cyan font-semibold">60-90 minutos</strong>. Explora el mapa interactivo abajo: haz clic para resaltar una comuna, doble clic para ver su ficha y desde ahí accede a su landing SEO dedicada.
        </p>

        <!-- Stats -->
        <div class="mt-10 grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-3xl mx-auto">
          <div class="bg-white/5 border border-white/10 rounded-xl-card p-4">
            <div class="text-3xl font-extrabold bg-gradient-to-r from-primary-cyan to-accent-orange bg-clip-text text-transparent">52</div>
            <div class="text-xs text-white/60 mt-1">Comunas RM</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-xl-card p-4">
            <div class="text-3xl font-extrabold bg-gradient-to-r from-primary-cyan to-accent-orange bg-clip-text text-transparent">8</div>
            <div class="text-xs text-white/60 mt-1">Zonas geográficas</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-xl-card p-4">
            <div class="text-3xl font-extrabold bg-gradient-to-r from-primary-cyan to-accent-orange bg-clip-text text-transparent">60-90</div>
            <div class="text-xs text-white/60 mt-1">Min tiempo respuesta</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-xl-card p-4">
            <div class="text-3xl font-extrabold bg-gradient-to-r from-primary-cyan to-accent-orange bg-clip-text text-transparent">$35K</div>
            <div class="text-xs text-white/60 mt-1">Precio inicial CLP</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mapa interactivo ampliado (con zoom/pan + ficha) -->
    <LeafletMap
      variant="full"
      title="Mapa Interactivo RM"
      subtitle="Click en cualquier comuna para ver ficha · Arrastra para moverte · Scroll o botones +/− para zoom"
    />

    <!-- Listado por zona -->
    <section class="bg-white py-16 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12" data-reveal>
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary-cyan/10 text-primary-teal text-sm font-semibold mb-4">
            <span class="h-1.5 w-1.5 rounded-full bg-primary-cyan"></span>
            Listado por Zona
          </span>
          <h2 class="text-3xl lg:text-4xl font-extrabold text-ink-dark tracking-tight">
            Comunas <span class="bg-gradient-to-r from-primary-cyan to-primary-teal bg-clip-text text-transparent">por Zona</span> Geográfica
          </h2>
          <p class="mt-4 text-lg text-text-muted max-w-2xl mx-auto">Explora las comunas agrupadas por su ubicación dentro de la Región Metropolitana.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6" data-reveal>
          {comunasPorZona.map(({ zona, items }) => (
            <div class="bg-bg-alt rounded-xl-card border border-border-light p-5">
              <div class="flex items-center gap-2 mb-4">
                <span class="h-3 w-3 rounded-full" style={`background: ${zonaColors[zona] || '#00BCD4'}`}></span>
                <h3 class="text-lg font-bold text-ink-dark">{zona}</h3>
                <span class="ml-auto text-xs text-text-muted bg-white border border-border-light rounded-full px-2 py-0.5">{items.length}</span>
              </div>
              <ul class="space-y-1.5">
                {items.map(c => (
                  <li>
                    <a href={`/comuna/${c.slug}`} class="text-sm text-text-muted hover:text-primary-teal hover:underline transition-colors block py-0.5">
                      {c.nombre}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA inferior -->
    <section class="bg-gradient-to-br from-dark-navy to-dark-navy-alt py-16">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl lg:text-3xl font-bold text-white">¿No ves tu comuna en la lista?</h2>
        <p class="mt-3 text-white/70">Escríbenos por WhatsApp y verificamos cobertura en zonas aledañas o rurales.</p>
        <a
          href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hola GlobalPro 👋, no veo mi comuna en la lista. ¿Tienen cobertura?')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 px-6 py-3 rounded-full bg-whatsapp-green text-white font-semibold hover:scale-105 active:scale-95 transition-transform"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24z"/></svg>
          Consultar cobertura por WhatsApp
        </a>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingActions />
</Layout>
