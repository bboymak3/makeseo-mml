---
/**
 * src/pages/comuna/[comuna].astro
 * Landing SEO por comuna. 52 páginas estáticas vía getStaticPaths.
 */
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import TrustBar from '../../components/TrustBar.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import PricingSection from '../../components/PricingSection.astro';
import Gallery from '../../components/Gallery.astro';
import FloatingActions from '../../components/FloatingActions.astro';
import Footer from '../../components/Footer.astro';
import { comunas } from '../../data/comunas.ts';

export function getStaticPaths() {
  return comunas.map((comuna) => ({
    params: { comuna: comuna.slug },
    props: { comuna },
  }));
}

const { comuna } = Astro.props as { comuna: typeof comunas[0] };

const WHATSAPP_NUMBER = '56987654321';
const WHATSAPP_MSG = encodeURIComponent(
  `Hola GlobalPro 👋, necesito recarga de gas aire acondicionado automotriz a domicilio en ${comuna.nombre}. ¿Me confirmas cobertura y precio?`
);
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${WHATSAPP_MSG}`;

const title = `Recarga de Gas Aire Acondicionado a Domicilio en ${comuna.nombre} | GlobalPro`;
const description = `Recarga de gas R134a a domicilio en ${comuna.nombre}, RM. Desde $35.000. Llegamos en ${comuna.tiempoRespuesta}. Técnicos certificados, boleta/factura electrónica. Reserva por WhatsApp.`;
const canonical = `/comuna/${comuna.slug}`;

const comunasVecinas = comunas.filter(c => c.zona === comuna.zona && c.slug !== comuna.slug).slice(0, 8);
---

<Layout title={title} description={description} canonical={canonical} comuna={comuna}>
  <Navbar />

  <main>
    <section id="inicio" class="relative overflow-hidden bg-dark-navy">
      <div class="absolute inset-0" aria-hidden="true">
        <picture>
          <source srcset="/images/gallery/recarga-gas-aire-acondicionado-automotriz-domicilio-santiago-1.webp" type="image/webp" />
          <img src="/images/gallery/recarga-gas-aire-acondicionado-automotriz-domicilio-santiago-1.jpg" alt="" width="900" height="1200" fetchpriority="high" class="w-full h-full object-cover opacity-25" />
        </picture>
        <div class="absolute inset-0 bg-gradient-to-br from-dark-navy/95 via-dark-navy/80 to-dark-navy/60"></div>
        <div class="absolute inset-0 bg-hero-radial"></div>
      </div>
      <div class="absolute -top-32 -left-32 w-96 h-96 bg-primary-cyan/20 rounded-full blur-3xl animate-pulse-slow" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-28 lg:pt-32 pb-16 lg:pb-24">
        <nav class="mb-6 text-sm text-white/60" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 flex-wrap">
            <li><a href="/" class="hover:text-primary-cyan">Inicio</a></li>
            <li>›</li>
            <li><a href="/#cobertura" class="hover:text-primary-cyan">Cobertura RM</a></li>
            <li>›</li>
            <li class="text-white font-semibold">{comuna.nombre}</li>
          </ol>
        </nav>

        <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          <div class="lg:col-span-7 space-y-7">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent-orange/10 border border-accent-orange/30 backdrop-blur-sm">
              <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-orange opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-accent-orange"></span>
              </span>
              <span class="text-sm font-semibold text-accent-orange-light">Desde $35.000 · Atención hoy en {comuna.nombre}</span>
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-[1.05] tracking-tight">
              Recarga de Gas <span class="bg-gradient-to-r from-primary-cyan to-primary-teal bg-clip-text text-transparent">Aire Acondicionado</span> Automotriz a Domicilio en {comuna.nombre}
            </h1>

            <p class="text-lg lg:text-xl text-white/70 max-w-2xl leading-relaxed">
              {comuna.descripcion} Atendemos en {comuna.nombre} con tiempo de respuesta de <strong class="text-primary-cyan font-semibold">{comuna.tiempoRespuesta}</strong>, gas refrigerante R134a de alta pureza y técnicos certificados.
            </p>

            {comuna.barrios && comuna.barrios.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {comuna.barrios.slice(0, 6).map((barrio) => (
                  <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-white/70 text-xs">{barrio}</span>
                ))}
                {comuna.barrios.length > 6 && (
                  <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-white/50 text-xs">+{comuna.barrios.length - 6} sectores</span>
                )}
              </div>
            )}

            <div class="flex flex-col sm:flex-row gap-4">
              <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center justify-center gap-3 px-7 py-4 rounded-full bg-whatsapp-green text-white font-bold text-base shadow-glow-orange hover:scale-105 active:scale-95 transition-all">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24z"/></svg>
                <span>Reservar en {comuna.nombre}</span>
              </a>
              <a href="tel:+56987654321" class="inline-flex items-center justify-center gap-3 px-7 py-4 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-white font-bold text-base hover:bg-white/15 hover:scale-105 active:scale-95 transition-all">
                <svg class="w-6 h-6 text-primary-cyan" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.62 10.79a15.46 15.46 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.24.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.21 2.2z"/></svg>
                Llamar Ahora
              </a>
            </div>

            <p class="text-sm text-white/50 flex items-center gap-2">
              <svg class="w-4 h-4 text-whatsapp-green" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12c0 1.733.455 3.36 1.247 4.767L2 22l5.367-1.247C8.76 19.545 10.273 20 12 20c5.523 0 10-4.477 10-10S17.523 2 12 2z"/></svg>
              Respuesta inmediata · {comuna.tiempoRespuesta} · Zona {comuna.zona}
            </p>
          </div>

          <div class="lg:col-span-5">
            <div class="relative">
              <div class="absolute -inset-1 bg-gradient-to-br from-primary-cyan/30 to-accent-orange/30 rounded-3xl blur-2xl animate-glow-pulse" aria-hidden="true"></div>
              <div class="relative rounded-3xl bg-dark-navy-alt/60 backdrop-blur-xl border border-white/10 p-7 shadow-2xl">
                <div class="flex items-center gap-3 mb-5">
                  <div class="h-12 w-12 rounded-xl bg-gradient-to-br from-primary-cyan to-primary-teal flex items-center justify-center">
                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg>
                  </div>
                  <div>
                    <h2 class="text-white font-bold text-lg">Cobertura en {comuna.nombre}</h2>
                    <p class="text-white/60 text-sm">Zona {comuna.zona} · Región Metropolitana</p>
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3 mb-4">
                  <div class="bg-white/5 border border-white/10 rounded-lg p-3">
                    <p class="text-[10px] text-white/50 uppercase">Tiempo</p>
                    <p class="text-base font-bold text-accent-orange-light">{comuna.tiempoRespuesta}</p>
                  </div>
                  <div class="bg-white/5 border border-white/10 rounded-lg p-3">
                    <p class="text-[10px] text-white/50 uppercase">Desde</p>
                    <p class="text-base font-bold text-accent-orange-light">$35.000</p>
                  </div>
                </div>
                <ul class="space-y-2.5 text-sm text-white/85">
                  <li class="flex items-start gap-3"><span class="mt-0.5 flex-shrink-0 h-5 w-5 rounded-full bg-whatsapp-green/20 border border-whatsapp-green/50 flex items-center justify-center"><svg class="w-3 h-3 text-whatsapp-green" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>Gas R134a de alta pureza</li>
                  <li class="flex items-start gap-3"><span class="mt-0.5 flex-shrink-0 h-5 w-5 rounded-full bg-whatsapp-green/20 border border-whatsapp-green/50 flex items-center justify-center"><svg class="w-3 h-3 text-whatsapp-green" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>Vacío del sistema incluido</li>
                  <li class="flex items-start gap-3"><span class="mt-0.5 flex-shrink-0 h-5 w-5 rounded-full bg-whatsapp-green/20 border border-whatsapp-green/50 flex items-center justify-center"><svg class="w-3 h-3 text-whatsapp-green" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>Garantía escrita 90 días</li>
                  <li class="flex items-start gap-3"><span class="mt-0.5 flex-shrink-0 h-5 w-5 rounded-full bg-whatsapp-green/20 border border-whatsapp-green/50 flex items-center justify-center"><svg class="w-3 h-3 text-whatsapp-green" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>Boleta o factura electrónica</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="relative -mb-1" aria-hidden="true">
        <svg class="w-full h-12 lg:h-20 text-white" fill="currentColor" viewBox="0 0 1440 80" preserveAspectRatio="none">
          <path d="M0 80h1440V40c-240 26-480 26-720 13S240 14 0 40v40z"/>
        </svg>
      </div>
    </section>

    <TrustBar />
    <ServicesGrid />
    <ProcessSteps />
    <PricingSection />

    <section id="faq" class="bg-bg-alt py-20 lg:py-28">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12" data-reveal>
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-accent-orange/10 text-accent-orange text-sm font-semibold mb-4">
            <span class="h-1.5 w-1.5 rounded-full bg-accent-orange"></span>
            Preguntas Frecuentes en {comuna.nombre}
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink-dark tracking-tight">
            Preguntas sobre Recarga de Gas en <span class="bg-gradient-to-r from-primary-cyan to-primary-teal bg-clip-text text-transparent">{comuna.nombre}</span>
          </h2>
          <p class="mt-5 text-lg text-text-muted">Respuestas a las dudas más comunes de nuestros clientes en {comuna.nombre}.</p>
        </div>

        <div class="space-y-3" data-reveal>
          {comuna.faqs.map((faq, index) => (
            <div class="bg-white rounded-xl-card border border-border-light overflow-hidden shadow-card">
              <h3>
                <button type="button" class="comuna-faq-trigger w-full flex items-center justify-between gap-4 px-5 lg:px-6 py-5 text-left hover:bg-bg-alt/50 transition-colors" aria-expanded="false" aria-controls={`comuna-faq-panel-${index}`}>
                  <span class="text-base lg:text-lg font-bold text-ink-dark leading-snug">{faq.question}</span>
                  <span class="flex-shrink-0 h-8 w-8 rounded-full bg-primary-cyan/10 border border-primary-cyan/20 flex items-center justify-center text-primary-teal">
                    <svg class="w-5 h-5 comuna-faq-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                  </span>
                </button>
              </h3>
              <div id={`comuna-faq-panel-${index}`} role="region" class="comuna-faq-panel hidden px-5 lg:px-6 pb-5">
                <p class="text-text-muted leading-relaxed text-sm lg:text-base">{faq.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Gallery variant="compact" title={`Trabajos Recientes en ${comuna.nombre}`} subtitle={`Fotos reales de recarga de gas aire acondicionado automotriz a domicilio realizados por GlobalPro en ${comuna.nombre} y comunas aledañas.`} />

    {comunasVecinas.length > 0 && (
      <section class="bg-white py-16 lg:py-20 border-t border-border-light">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-10" data-reveal>
            <h2 class="text-2xl lg:text-3xl font-extrabold text-ink-dark tracking-tight">
              También atendemos comunas vecinas en zona {comuna.zona}
            </h2>
            <p class="mt-3 text-text-muted">Cobertura continua en toda la zona {comuna.zona.toLowerCase()} de la Región Metropolitana.</p>
          </div>
          <div class="flex flex-wrap justify-center gap-2" data-reveal>
            {comunasVecinas.map((c) => (
              <a href={`/comuna/${c.slug}`} class="px-4 py-2 rounded-full bg-bg-alt border border-border-light text-ink-dark text-sm font-medium hover:bg-primary-cyan hover:text-white hover:border-primary-cyan transition-all">{c.nombre}</a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
  <FloatingActions />
</Layout>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>('.comuna-faq-trigger');
  const panels = document.querySelectorAll<HTMLElement>('.comuna-faq-panel');
  triggers.forEach((trigger, index) => {
    trigger.addEventListener('click', () => {
      const panel = panels[index];
      const icon = trigger.querySelector('.comuna-faq-icon');
      const isOpen = !panel.classList.contains('hidden');
      panels.forEach((p, i) => {
        if (i !== index) {
          p.classList.add('hidden');
          triggers[i].setAttribute('aria-expanded', 'false');
          triggers[i].querySelector('.comuna-faq-icon')?.style.setProperty('transform', 'rotate(0deg)');
        }
      });
      if (isOpen) {
        panel.classList.add('hidden');
        trigger.setAttribute('aria-expanded', 'false');
        icon?.style.setProperty('transform', 'rotate(0deg)');
      } else {
        panel.classList.remove('hidden');
        trigger.setAttribute('aria-expanded', 'true');
        icon?.style.setProperty('transform', 'rotate(180deg)');
      }
    });
  });
</script>
