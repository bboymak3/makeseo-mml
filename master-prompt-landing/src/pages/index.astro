  <!-- Script para copiar al portapapeles -->
  <script is:inline define:vars={{ promptText: masterPrompt }}>
    const copyToClipboard = async (btnId) => {
      const btn = document.getElementById(btnId);
      if (!btn) return;
      const originalText = btn.querySelector('span')?.textContent || 'Copiar prompt';
      try {
        await navigator.clipboard.writeText(promptText);
        // Feedback visual
        const span = btn.querySelector('span');
        if (span) span.textContent = '¡Copiado!';
        btn.classList.add('bg-whatsapp-green');
        btn.classList.remove('bg-gradient-orange');

        // Mostrar aviso
        const feedback = document.getElementById('copy-feedback');
        if (feedback) {
          feedback.classList.remove('hidden');
          feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        // Restaurar después de 2.5s
        setTimeout(() => {
          if (span) span.textContent = originalText;
          btn.classList.remove('bg-whatsapp-green');
          btn.classList.add('bg-gradient-orange');
          if (feedback) feedback.classList.add('hidden');
        }, 2500);
      } catch (err) {
        // Fallback para navegadores antiguos
        const textarea = document.createElement('textarea');
        textarea.value = promptText;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        try {
          document.execCommand('copy');
          const span = btn.querySelector('span');
          if (span) span.textContent = '¡Copiado!';
          setTimeout(() => { if (span) span.textContent = originalText; }, 2500);
        } catch (e) {
          alert('No se pudo copiar automáticamente. Selecciona el texto manualmente.');
        }
        document.body.removeChild(textarea);
      }
    };

    document.getElementById('copy-btn')?.addEventListener('click', () => copyToClipboard('copy-btn'));
    document.getElementById('copy-btn-bottom')?.addEventListener('click', () => copyToClipboard('copy-btn-bottom'));
  </script>
